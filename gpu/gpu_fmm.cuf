module fmm_device
  use amr_parameters, only: dp, ndim, twotondim, threetondim, multipole_size, taylor_size
  use oct_commons, only: oct
  use gpu_utils
  use cudafor
  implicit none

contains

  include 'gpu_hash.cuf'
  include 'gpu_nbor.cuf'

  ! =========================================================================
  attributes(device) subroutine fmm_shift_multipole(multipole_in, a, multipole_out)
    real(kind=dp), intent(in)  :: multipole_in(1:multipole_size)
    real(kind=dp), intent(in)  :: a(1:3)
    real(kind=dp), intent(out) :: multipole_out(1:multipole_size)

    real(kind=dp) :: mp_in
    real(kind=dp) :: dp_in(3), dp_out(3)
    real(kind=dp) :: qp_in(3,3), qp_out(3,3)
    integer :: i, j

    mp_in = multipole_in(1)
    multipole_out = 0.0_dp
    multipole_out(1) = mp_in

    dp_in = 0.0_dp
    dp_out = 0.0_dp
    do i = 1, ndim
       dp_in(i) = multipole_in(1+i)
       dp_out(i) = dp_in(i) - a(i) * mp_in
       multipole_out(1+i) = dp_out(i)
    end do

    qp_in = 0.0_dp
#if NDIM==1
    qp_in(1,1) = multipole_in(3)
#endif
#if NDIM==2
    qp_in(1,1) = multipole_in(4)
    qp_in(1,2) = multipole_in(5); qp_in(2,1) = qp_in(1,2)
    qp_in(2,2) = multipole_in(6)
#endif
#if NDIM==3
    qp_in(1,1) = multipole_in(5)
    qp_in(1,2) = multipole_in(6); qp_in(2,1) = qp_in(1,2)
    qp_in(1,3) = multipole_in(7); qp_in(3,1) = qp_in(1,3)
    qp_in(2,2) = multipole_in(8)
    qp_in(2,3) = multipole_in(9); qp_in(3,2) = qp_in(2,3)
    qp_in(3,3) = multipole_in(10)
#endif

    qp_out = 0.0_dp
    do i = 1, ndim
       do j = 1, ndim
          qp_out(i,j) = qp_in(i,j) - (a(i)*dp_in(j) + dp_in(i)*a(j)) + mp_in*a(i)*a(j)
       end do
    end do

#if NDIM==1
    multipole_out(3) = qp_out(1,1)
#endif
#if NDIM==2
    multipole_out(4) = qp_out(1,1)
    multipole_out(5) = qp_out(1,2)
    multipole_out(6) = qp_out(2,2)
#endif
#if NDIM==3
    multipole_out(5)  = qp_out(1,1)
    multipole_out(6)  = qp_out(1,2)
    multipole_out(7)  = qp_out(1,3)
    multipole_out(8)  = qp_out(2,2)
    multipole_out(9)  = qp_out(2,3)
    multipole_out(10) = qp_out(3,3)
#endif

  end subroutine fmm_shift_multipole
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine fmm_calc_taylor_from_multipole(R, D0, D1, D2, D3, multipoles, taylor_coeff)
    real(kind=dp), intent(in)  :: R(1:3), D0, D1, D2, D3
    real(kind=dp), intent(in)  :: multipoles(1:multipole_size)
    real(kind=dp), intent(out) :: taylor_coeff(1:taylor_size)

    real(kind=dp) :: trM, S, RdotM1
    real(kind=dp) :: MR1, MR2, MR3

    taylor_coeff = 0.0_dp
#if NDIM==1
    trM = multipoles(3)
    MR1 = multipoles(3)*R(1)
    S = R(1)*MR1
    RdotM1 = R(1)*multipoles(2)

    taylor_coeff(1) = multipoles(1)*D0 - RdotM1*D1 + 0.5_dp*(trM*D1 + S*D2)
    taylor_coeff(2) = multipoles(1)*R(1)*D1 - multipoles(2)*D1 &
         & - R(1)*RdotM1*D2 + 0.5_dp*R(1)*trM*D2 + 0.5_dp*R(1)*S*D3 + MR1*D2
    taylor_coeff(3) = multipoles(1)*(D1 + R(1)**2*D2) &
         & - RdotM1*D2 - 2*R(1)*multipoles(2)*D2 - R(1)**2*RdotM1*D3
    taylor_coeff(4) = multipoles(1)*(3*R(1)*D2 + R(1)**3*D3)
#endif

#if NDIM==2
    trM = multipoles(4) + multipoles(6)
    MR1 = multipoles(4)*R(1) + multipoles(5)*R(2)
    MR2 = multipoles(5)*R(1) + multipoles(6)*R(2)
    S = R(1)*MR1 + R(2)*MR2
    RdotM1 = R(1)*multipoles(2) + R(2)*multipoles(3)

    taylor_coeff(1) = multipoles(1)*D0 - RdotM1*D1 + 0.5_dp*(trM*D1 + S*D2)
    taylor_coeff(2) = multipoles(1)*R(1)*D1 - multipoles(2)*D1 + MR1*D2 &
         & - R(1)*RdotM1*D2 + 0.5_dp*R(1)*(trM*D2 + S*D3)
    taylor_coeff(3) = multipoles(1)*R(2)*D1 - multipoles(3)*D1 + MR2*D2 &
         & - R(2)*RdotM1*D2 + 0.5_dp*R(2)*(trM*D2 + S*D3)
    taylor_coeff(4) = multipoles(1)*(D1 + R(1)**2*D2) &
         & - RdotM1*D2 - 2*R(1)*multipoles(2)*D2 - R(1)**2*RdotM1*D3
    taylor_coeff(5) = multipoles(1)*(R(1)*R(2)*D2) &
         & - R(1)*multipoles(3)*D2 - R(2)*multipoles(2)*D2 - R(1)*R(2)*RdotM1*D3
    taylor_coeff(6) = multipoles(1)*(D1 + R(2)**2*D2) &
         & - RdotM1*D2 - 2*R(2)*multipoles(3)*D2 - R(2)**2*RdotM1*D3
    taylor_coeff(7) = multipoles(1)*(3*R(1)*D2 + R(1)**3*D3)
    taylor_coeff(8) = multipoles(1)*(R(2)*D2 + R(1)*R(1)*R(2)*D3)
    taylor_coeff(9) = multipoles(1)*(R(1)*D2 + R(1)*R(2)*R(2)*D3)
    taylor_coeff(10)= multipoles(1)*(3*R(2)*D2 + R(2)**3*D3)
#endif

#if NDIM==3
    trM = multipoles(5) + multipoles(8) + multipoles(10)
    MR1 = multipoles(5)*R(1) + multipoles(6)*R(2) + multipoles(7)*R(3)
    MR2 = multipoles(6)*R(1) + multipoles(8)*R(2) + multipoles(9)*R(3)
    MR3 = multipoles(7)*R(1) + multipoles(9)*R(2) + multipoles(10)*R(3)
    S = R(1)*MR1 + R(2)*MR2 + R(3)*MR3
    RdotM1 = R(1)*multipoles(2) + R(2)*multipoles(3) + R(3)*multipoles(4)

    taylor_coeff(1) = multipoles(1)*D0 - RdotM1*D1 + 0.5_dp*(trM*D1 + S*D2)
    taylor_coeff(2) = multipoles(1)*R(1)*D1 - multipoles(2)*D1 - R(1)*RdotM1*D2 + 0.5_dp*R(1)*trM*D2 + 0.5_dp*R(1)*S*D3 + MR1*D2
    taylor_coeff(3) = multipoles(1)*R(2)*D1 - multipoles(3)*D1 - R(2)*RdotM1*D2 + 0.5_dp*R(2)*trM*D2 + 0.5_dp*R(2)*S*D3 + MR2*D2
    taylor_coeff(4) = multipoles(1)*R(3)*D1 - multipoles(4)*D1 - R(3)*RdotM1*D2 + 0.5_dp*R(3)*trM*D2 + 0.5_dp*R(3)*S*D3 + MR3*D2
    taylor_coeff(5) = multipoles(1)*(D1 + R(1)**2*D2) - RdotM1*D2 - 2*R(1)*multipoles(2)*D2           - R(1)**2*RdotM1*D3
    taylor_coeff(6) = multipoles(1)*(R(1)*R(2)*D2)    - R(1)*multipoles(3)*D2 - R(2)*multipoles(2)*D2 - R(1)*R(2)*RdotM1*D3
    taylor_coeff(7) = multipoles(1)*(D1 + R(2)**2*D2) - RdotM1*D2 - 2*R(2)*multipoles(3)*D2           - R(2)**2*RdotM1*D3
    taylor_coeff(8) = multipoles(1)*(R(1)*R(3)*D2)    - R(1)*multipoles(4)*D2 - R(3)*multipoles(2)*D2 - R(1)*R(3)*RdotM1*D3
    taylor_coeff(9) = multipoles(1)*(R(2)*R(3)*D2)    - R(2)*multipoles(4)*D2 - R(3)*multipoles(3)*D2 - R(2)*R(3)*RdotM1*D3
    taylor_coeff(10)= multipoles(1)*(D1 + R(3)**2*D2) - RdotM1*D2 - 2*R(3)*multipoles(4)*D2           - R(3)**2*RdotM1*D3
    taylor_coeff(11) = multipoles(1)*(3*R(1)*D2 + R(1)*R(1)*R(1)*D3)
    taylor_coeff(12) = multipoles(1)*(R(2)*D2   + R(1)*R(1)*R(2)*D3)
    taylor_coeff(13) = multipoles(1)*(R(1)*D2   + R(1)*R(2)*R(2)*D3)
    taylor_coeff(14) = multipoles(1)*(3*R(2)*D2 + R(2)*R(2)*R(2)*D3)
    taylor_coeff(15) = multipoles(1)*(R(3)*D2   + R(1)*R(1)*R(3)*D3)
    taylor_coeff(16) = multipoles(1)*(             R(1)*R(2)*R(3)*D3)
    taylor_coeff(17) = multipoles(1)*(R(3)*D2   + R(2)*R(2)*R(3)*D3)
    taylor_coeff(18) = multipoles(1)*(R(1)*D2   + R(1)*R(3)*R(3)*D3)
    taylor_coeff(19) = multipoles(1)*(R(2)*D2   + R(2)*R(3)*R(3)*D3)
    taylor_coeff(20) = multipoles(1)*(3*R(3)*D2 + R(3)*R(3)*R(3)*D3)
#endif

  end subroutine fmm_calc_taylor_from_multipole
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine fmm_calc_phi_from_multipole(R, D0, D1, D2, multipoles, phi_out)
    real(kind=dp), intent(in)  :: R(1:3), D0, D1, D2
    real(kind=dp), intent(in)  :: multipoles(1:multipole_size)
    real(kind=dp), intent(out) :: phi_out

    real(kind=dp) :: S

#if NDIM==1
    S = multipoles(3) * R(1) * R(1)
    phi_out = - (multipoles(1)*D0 - multipoles(2)*R(1)*D1 + 0.5_dp*(multipoles(3)*D1 + S*D2))
#endif
#if NDIM==2
    S = multipoles(4)*R(1)*R(1) + 2.0_dp*multipoles(5)*R(1)*R(2) + multipoles(6)*R(2)*R(2)
    phi_out = - (multipoles(1)*D0 - (multipoles(2)*R(1) + multipoles(3)*R(2))*D1 + &
         & 0.5_dp*((multipoles(4)+multipoles(6))*D1 + S*D2))
#endif
#if NDIM==3
    S = multipoles(5)*R(1)*R(1) + 2.0_dp*multipoles(6)*R(1)*R(2) + 2.0_dp*multipoles(7)*R(1)*R(3) + &
         & multipoles(8)*R(2)*R(2) + 2.0_dp*multipoles(9)*R(2)*R(3) + multipoles(10)*R(3)*R(3)
    phi_out = - (multipoles(1)*D0 - (multipoles(2)*R(1) + multipoles(3)*R(2) + multipoles(4)*R(3))*D1 + &
         & 0.5_dp*((multipoles(5)+multipoles(8)+multipoles(10))*D1 + S*D2))
#endif

  end subroutine fmm_calc_phi_from_multipole
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine fmm_shift_taylor(taylor_in, a, taylor_out)
    real(kind=dp), intent(in)  :: taylor_in(1:taylor_size)
    real(kind=dp), intent(in)  :: a(1:3)
    real(kind=dp), intent(out) :: taylor_out(1:taylor_size)

    integer :: i, j, k, idx, nq, no, idxC2, idxC3
    real(kind=dp) :: C0, C0p
    real(kind=dp) :: C1(3), C1p(3)
    real(kind=dp) :: C2(3,3), C2p(3,3)
    real(kind=dp) :: C3(3,3,3), C3p(3,3,3)

    nq = ndim*(ndim+1)/2
    no = ndim*(ndim+1)*(ndim+2)/6
    idxC2 = 1 + ndim
    idxC3 = idxC2 + nq

    C0 = taylor_in(1)
    C1 = 0.0_dp; C1p = 0.0_dp
    C2 = 0.0_dp; C2p = 0.0_dp
    C3 = 0.0_dp; C3p = 0.0_dp

    do i = 1, ndim
       C1(i) = taylor_in(1+i)
    end do

    idx = 0
    do j = 1, ndim
       do i = 1, j
          idx = idx + 1
          C2(i,j) = taylor_in(idxC2+idx)
          C2(j,i) = C2(i,j)
       end do
    end do

    idx = 0
    do k = 1, ndim
       do j = 1, k
          do i = 1, j
             idx = idx + 1
             C3(i,j,k) = taylor_in(idxC3+idx)
             C3(i,k,j) = C3(i,j,k)
             C3(j,i,k) = C3(i,j,k)
             C3(j,k,i) = C3(i,j,k)
             C3(k,i,j) = C3(i,j,k)
             C3(k,j,i) = C3(i,j,k)
          end do
       end do
    end do

    C3p = C3
    do i = 1, ndim
       do j = 1, ndim
          C2p(i,j) = C2(i,j)
          do k = 1, ndim
             C2p(i,j) = C2p(i,j) + a(k)*C3(i,j,k)
          end do
       end do
    end do

    do i = 1, ndim
       C1p(i) = C1(i)
       do j = 1, ndim
          C1p(i) = C1p(i) + a(j)*C2(i,j)
          do k = 1, ndim
             C1p(i) = C1p(i) + 0.5_dp*a(j)*a(k)*C3(i,j,k)
          end do
       end do
    end do

    C0p = C0
    do i = 1, ndim
       C0p = C0p + a(i)*C1(i)
       do j = 1, ndim
          C0p = C0p + 0.5_dp*a(i)*a(j)*C2(i,j)
          do k = 1, ndim
             C0p = C0p + (1.0_dp/6.0_dp)*a(i)*a(j)*a(k)*C3(i,j,k)
          end do
       end do
    end do

    taylor_out = 0.0_dp
    taylor_out(1) = C0p
    do i = 1, ndim
       taylor_out(1+i) = C1p(i)
    end do

    idx = 0
    do j = 1, ndim
       do i = 1, j
          idx = idx + 1
          taylor_out(idxC2+idx) = C2p(i,j)
       end do
    end do

    idx = 0
    do k = 1, ndim
       do j = 1, k
          do i = 1, j
             idx = idx + 1
             taylor_out(idxC3+idx) = C3p(i,j,k)
          end do
       end do
    end do

  end subroutine fmm_shift_taylor
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine fmm_calc_phi(taylor_in, a, phi_out)
    real(kind=dp), intent(in)  :: taylor_in(1:taylor_size)
    real(kind=dp), intent(in)  :: a(1:3)
    real(kind=dp), intent(out) :: phi_out

#if NDIM==1
    phi_out = - taylor_in(1) - a(1)*taylor_in(2) - 0.5_dp*a(1)**2*taylor_in(3) - &
         & (1.0_dp/6.0_dp)*a(1)**3*taylor_in(4)
#endif
#if NDIM==2
    phi_out = - taylor_in(1) &
         & - a(1)*taylor_in(2) - a(2)*taylor_in(3) &
         & - 0.5_dp*(a(1)**2*taylor_in(4) + 2.0_dp*a(1)*a(2)*taylor_in(5) + a(2)**2*taylor_in(6)) &
         & - (1.0_dp/6.0_dp)*(a(1)**3*taylor_in(7) + 3.0_dp*a(1)**2*a(2)*taylor_in(8) + &
         & 3.0_dp*a(1)*a(2)**2*taylor_in(9) + a(2)**3*taylor_in(10))
#endif
#if NDIM==3
    phi_out = - taylor_in(1) &
         & - a(1)*taylor_in(2) - a(2)*taylor_in(3) - a(3)*taylor_in(4) &
         & - 0.5_dp*(a(1)**2*taylor_in(5) + 2.0_dp*a(1)*a(2)*taylor_in(6) + a(2)**2*taylor_in(7) &
         & + 2.0_dp*a(1)*a(3)*taylor_in(8) + 2.0_dp*a(2)*a(3)*taylor_in(9) + a(3)**2*taylor_in(10)) &
         & - (1.0_dp/6.0_dp)*(a(1)**3*taylor_in(11) + 3.0_dp*a(1)**2*a(2)*taylor_in(12) + &
         & 3.0_dp*a(1)**2*a(3)*taylor_in(15) + 3.0_dp*a(1)*a(2)**2*taylor_in(13) + &
         & 6.0_dp*a(1)*a(2)*a(3)*taylor_in(16) + 3.0_dp*a(1)*a(3)**2*taylor_in(18) + &
         & a(2)**3*taylor_in(14) + 3.0_dp*a(2)**2*a(3)*taylor_in(17) + &
         & 3.0_dp*a(2)*a(3)**2*taylor_in(19) + a(3)**3*taylor_in(20))
#endif

  end subroutine fmm_calc_phi
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_reset_multipole_taylor(multipole, taylor_coeff, head_idx, num_octs)
    real(kind=dp), device :: multipole(1:twotondim,1:multipole_size,*)
    real(kind=dp), device :: taylor_coeff(1:twotondim,1:taylor_size,*)
    integer(kind=4), value :: head_idx
    integer(kind=4), value :: num_octs

    integer :: cell_idx, oct_idx, block_idx, q

    block_idx = blockIdx%x - 1
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx
    cell_idx = threadIdx%x

    do q = 1, multipole_size
       multipole(cell_idx, q, oct_idx) = 0.0_dp
    end do
    do q = 1, taylor_size
       taylor_coeff(cell_idx, q, oct_idx) = 0.0_dp
    end do

  end subroutine fmm_reset_multipole_taylor
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_multipole_amr2fmm(grid_amr, rho_amr, grid_fmm, multipole_fmm, hash_key_fmm, &
       & hash_val_fmm, hash_size_fmm, ckey_max, key_off, head_idx, num_octs, ilevel, level_fmm_to_amr, &
       & dx_loc, vol_loc, skip1, skip2, skip3)
    type(oct), device :: grid_amr(*)
    real(kind=dp), device :: rho_amr(1:twotondim,*)
    type(oct), device :: grid_fmm(*)
    real(kind=dp), device :: multipole_fmm(1:twotondim,1:multipole_size,*)
    integer(kind=8), device :: hash_key_fmm(*)
    integer(kind=4), device :: hash_val_fmm(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), value :: hash_size_fmm
    integer(kind=4), value :: head_idx, num_octs, ilevel, level_fmm_to_amr
    real(kind=dp), value :: dx_loc, vol_loc, skip1, skip2, skip3

    integer :: thread_idx, oct_idx, ind, idim, q, nstride, qidx
    integer :: nfine, half_nfine, igrid_fmm, icell_fmm
    integer(kind=4) :: fmm_ckey(1:3), child_in_cell(1:3)
    real(kind=dp) :: x(1:3), mass, multipole(1:multipole_size), info

    thread_idx = threadIdx%x - 1
    oct_idx = thread_idx + (blockIdx%x - 1) * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    nfine = 2**level_fmm_to_amr
    half_nfine = max(1, nfine / 2)
    fmm_ckey = 0
    child_in_cell = 0
    do idim = 1, ndim
       fmm_ckey(idim) = grid_amr(oct_idx)%ckey(idim) / nfine
       child_in_cell(idim) = (grid_amr(oct_idx)%ckey(idim) - nfine * fmm_ckey(idim)) / half_nfine
    end do

    icell_fmm = 1
    do idim = 1, ndim
       icell_fmm = icell_fmm + 2**(idim-1) * child_in_cell(idim)
    end do

    igrid_fmm = lookup_grid_by_ckey(fmm_ckey, ilevel-level_fmm_to_amr, hash_key_fmm, hash_val_fmm, &
         & hash_size_fmm, ckey_max, key_off)
    if (igrid_fmm <= 0) return

    multipole = 0.0_dp
    do ind = 1, twotondim
       if (grid_amr(oct_idx)%refined(ind)) cycle

       x = 0.0_dp
       do idim = 1, ndim
          nstride = 2**(idim-1)
          x(idim) = (2.0_dp*grid_amr(oct_idx)%ckey(idim) + &
               & real(mod((ind-1)/nstride, 2), kind=dp) + 0.5_dp) * dx_loc
       end do
       x(1) = x(1) - skip1
#if NDIM>1
       x(2) = x(2) - skip2
#endif
#if NDIM>2
       x(3) = x(3) - skip3
#endif

       mass = rho_amr(ind, oct_idx) * vol_loc
       multipole(1) = multipole(1) + mass
       do idim = 1, ndim
          multipole(1+idim) = multipole(1+idim) + mass * x(idim)
       end do

       qidx = 1 + ndim
       do idim = 1, ndim
          do q = idim, ndim
             qidx = qidx + 1
             multipole(qidx) = multipole(qidx) + mass * x(idim) * x(q)
          end do
       end do
    end do

    do q = 1, multipole_size
       info = atomicadd(multipole_fmm(icell_fmm, q, igrid_fmm), multipole(q))
    end do

  end subroutine fmm_multipole_amr2fmm
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_multipole_fmm2fmm(grid_fmm, multipole_fmm, hash_key_fmm, hash_val_fmm, &
       & hash_size_fmm, ckey_max, key_off, head_idx, num_octs)
    type(oct), device :: grid_fmm(*)
    real(kind=dp), device :: multipole_fmm(1:twotondim,1:multipole_size,*)
    integer(kind=8), device :: hash_key_fmm(*)
    integer(kind=4), device :: hash_val_fmm(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), value :: hash_size_fmm
    integer(kind=4), value :: head_idx, num_octs

    integer :: thread_idx, oct_idx, ind, q
    integer(kind=4) :: parent_idx, parent_cell, child_ckey(1:3)
    integer :: idim
    real(kind=dp) :: parent_multipole(1:multipole_size), info

    thread_idx = threadIdx%x - 1
    oct_idx = thread_idx + (blockIdx%x - 1) * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    child_ckey = 0
    do idim = 1, ndim
       child_ckey(idim) = grid_fmm(oct_idx)%ckey(idim)
    end do
    call get_parent_cell_device(grid_fmm, hash_key_fmm, hash_val_fmm, hash_size_fmm, ckey_max, key_off, &
         & child_ckey, grid_fmm(oct_idx)%lev, parent_idx, parent_cell)
    if (parent_idx <= 0) return

    parent_multipole = 0.0_dp
    do ind = 1, twotondim
       do q = 1, multipole_size
          parent_multipole(q) = parent_multipole(q) + multipole_fmm(ind, q, oct_idx)
       end do
    end do

    do q = 1, multipole_size
       info = atomicadd(multipole_fmm(parent_cell, q, parent_idx), parent_multipole(q))
    end do

  end subroutine fmm_multipole_fmm2fmm
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_multipole_shift_downward(grid_fmm, multipole_fmm, head_idx, num_octs, &
       & dx_loc, skip1, skip2, skip3)
    type(oct), device :: grid_fmm(*)
    real(kind=dp), device :: multipole_fmm(1:twotondim,1:multipole_size,*)
    integer(kind=4), value :: head_idx, num_octs
    real(kind=dp), value :: dx_loc, skip1, skip2, skip3

    integer :: cell_idx, oct_idx, block_idx, idim, nstride
    real(kind=dp) :: a(1:3), multipole_in(1:multipole_size), multipole_out(1:multipole_size)

    block_idx = blockIdx%x - 1
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx
    cell_idx = threadIdx%x

    a = 0.0_dp
    do idim = 1, ndim
       nstride = 2**(idim-1)
       a(idim) = (2.0_dp*grid_fmm(oct_idx)%ckey(idim) + &
            & real(mod((cell_idx-1)/nstride, 2), kind=dp) + 0.5_dp) * dx_loc
    end do
    a(1) = a(1) - skip1
#if NDIM>1
    a(2) = a(2) - skip2
#endif
#if NDIM>2
    a(3) = a(3) - skip3
#endif

    multipole_in = multipole_fmm(cell_idx, 1:multipole_size, oct_idx)
    call fmm_shift_multipole(multipole_in, a, multipole_out)
    multipole_fmm(cell_idx, 1:multipole_size, oct_idx) = multipole_out

  end subroutine fmm_multipole_shift_downward
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_downward_kernel(grid_target, taylor_target, hash_key_target, hash_val_target, &
       & grid_source, multipole_source, taylor_source, hash_key_source, hash_val_source, hash_size_target, &
       & hash_size_source, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_octs, &
       & ilev, jlev, flev, dx_loc)
    type(oct), device :: grid_target(*), grid_source(*)
    real(kind=dp), device :: taylor_target(1:twotondim,1:taylor_size,*)
    real(kind=dp), device :: multipole_source(1:twotondim,1:multipole_size,*)
    real(kind=dp), device :: taylor_source(1:twotondim,1:taylor_size,*)
    integer(kind=8), device :: hash_key_target(*), hash_key_source(*)
    integer(kind=4), device :: hash_val_target(*), hash_val_source(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
    logical, device :: periodic(1:3)
    integer(kind=4), value :: hash_size_target, hash_size_source
    integer(kind=4), value :: head_idx, num_octs, ilev, jlev, flev
    real(kind=dp), value :: dx_loc

    integer :: thread_idx, ioct, idim, icell, jcell, inbor, q, nstride
    integer(kind=4) :: hash_key(1:3), hash_parent(1:3), hash_nbor_periodic(1:3)
    integer(kind=4) :: pcell, target_cell_coord(1:3), source_cell_coord(1:3)
    integer(kind=4) :: icell_coord(1:3), offset(1:3), cc_icell(1:3), cc_jcell(1:3)
    integer(kind=4) :: grid_nbors(1:threetondim), igrid_nbor, igrid_parent
    real(kind=dp) :: dx_shift(1:3), diff(1:3), dist, D0, D1, D2, D3
    real(kind=dp) :: multipole(1:multipole_size), temp_taylor(1:taylor_size)
    real(kind=dp) :: accum_taylor(1:twotondim,1:taylor_size), parent_taylor(1:taylor_size)
    logical :: direct_neighbor, cycle_flag, nonzero_multipole

    thread_idx = threadIdx%x - 1
    ioct = thread_idx + (blockIdx%x - 1) * blockDim%x
    if (ioct >= num_octs) return
    ioct = head_idx + ioct

    hash_key = 0
    hash_parent = 0
    target_cell_coord = 0
    do idim = 1, ndim
       hash_key(idim) = grid_target(ioct)%ckey(idim)
       hash_parent(idim) = hash_key(idim) / 2
       target_cell_coord(idim) = hash_key(idim) - 2 * hash_parent(idim)
    end do

    pcell = 1
    do idim = 1, ndim
       pcell = pcell + 2**(idim-1) * target_cell_coord(idim)
    end do

    accum_taylor = 0.0_dp

    if (ilev == jlev) then
       call get_parent_cell_device(grid_target, hash_key_target, hash_val_target, hash_size_target, &
            & ckey_max, key_off, hash_key, flev, igrid_parent, pcell)
       parent_taylor = 0.0_dp
       if (igrid_parent > 0) parent_taylor = taylor_source(pcell, 1:taylor_size, igrid_parent)

       do icell = 1, twotondim
          dx_shift = 0.0_dp
          do idim = 1, ndim
             nstride = 2**(idim-1)
             dx_shift(idim) = (real(mod((icell-1)/nstride, 2), kind=dp) - 0.5_dp) * dx_loc
          end do
          call fmm_shift_taylor(parent_taylor, dx_shift, temp_taylor)
          do q = 1, taylor_size
             accum_taylor(icell, q) = accum_taylor(icell, q) + temp_taylor(q)
          end do
       end do
    end if

    call get_intermediate_nbor_grid_device(hash_key_source, hash_val_source, hash_size_source, &
         & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, hash_key, flev, grid_nbors)

    do inbor = 1, threetondim
       do idim = 1, ndim
          offset(idim) = mod((inbor-1)/3**(idim-1), 3) - 1
          hash_nbor_periodic(idim) = hash_parent(idim) + offset(idim)
       end do

       igrid_nbor = grid_nbors(inbor)
       if (igrid_nbor <= 0) cycle

       do jcell = 1, twotondim
          multipole = multipole_source(jcell, 1:multipole_size, igrid_nbor)
          nonzero_multipole = .false.
          do q = 1, multipole_size
             nonzero_multipole = nonzero_multipole .or. multipole(q) /= 0.0_dp
          end do
          if (.not. nonzero_multipole) cycle

          source_cell_coord = 0
          cycle_flag = .false.
          do idim = 1, ndim
             nstride = 2**(idim-1)
             source_cell_coord(idim) = mod((jcell-1)/nstride, 2)
             if (2*hash_nbor_periodic(idim) + source_cell_coord(idim) < box_ckey_min(idim, flev) .or. &
                 2*hash_nbor_periodic(idim) + source_cell_coord(idim) >= box_ckey_max(idim, flev)) then
                cycle_flag = .true.
             end if
          end do
          if (cycle_flag) cycle

          cc_jcell = 0
          do idim = 1, ndim
             cc_jcell(idim) = 2 * offset(idim) + source_cell_coord(idim)
          end do

          direct_neighbor = .true.
          do idim = 1, ndim
             if (abs(cc_jcell(idim) - target_cell_coord(idim)) > 1) direct_neighbor = .false.
          end do
          if (direct_neighbor) cycle

          do icell = 1, twotondim
             icell_coord = 0
             cc_icell = 0
             diff = 0.0_dp
             do idim = 1, ndim
                nstride = 2**(idim-1)
                icell_coord(idim) = mod((icell-1)/nstride, 2)
                cc_icell(idim) = 2 * target_cell_coord(idim) + icell_coord(idim)
                diff(idim) = (real(cc_icell(idim), kind=dp) - 0.5_dp - &
                     & 2.0_dp * real(cc_jcell(idim), kind=dp)) * dx_loc
             end do
             dist = sqrt(sum(diff(1:ndim)**2))
             D0 = 1.0_dp / dist
             D1 = -1.0_dp / dist**3
             D2 = 3.0_dp / dist**5
             D3 = -15.0_dp / dist**7
             call fmm_calc_taylor_from_multipole(diff, D0, D1, D2, D3, multipole, temp_taylor)
             do q = 1, taylor_size
                accum_taylor(icell, q) = accum_taylor(icell, q) + temp_taylor(q)
             end do
          end do
       end do
    end do

    do icell = 1, twotondim
       do q = 1, taylor_size
          taylor_target(icell, q, ioct) = taylor_target(icell, q, ioct) + accum_taylor(icell, q)
       end do
    end do

  end subroutine fmm_downward_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_amr_intermediate_kernel(grid_amr, phi_amr, grid_source, multipole_source, &
       & taylor_source, hash_key_source, hash_val_source, hash_size_source, ckey_max, key_off, box_ckey_min, &
       & box_ckey_max, periodic, head_idx, num_octs, ilev, jlev, level_fmm_to_amr, dx_loc, reset_phi)
    type(oct), device :: grid_amr(*), grid_source(*)
    real(kind=dp), device :: phi_amr(1:twotondim,*)
    real(kind=dp), device :: multipole_source(1:twotondim,1:multipole_size,*)
    real(kind=dp), device :: taylor_source(1:twotondim,1:taylor_size,*)
    integer(kind=8), device :: hash_key_source(*)
    integer(kind=4), device :: hash_val_source(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
    logical, device :: periodic(1:3)
    integer(kind=4), value :: hash_size_source, head_idx, num_octs, ilev, jlev, level_fmm_to_amr
    real(kind=dp), value :: dx_loc
    logical, value :: reset_phi

    integer :: thread_idx, ioct, idim, icell, jcell, inbor, q, nstride
    integer(kind=4) :: nfine, half_nfine, fmm_level, fmm_cell_level
    integer(kind=4) :: hash_key(1:3), hash_fmm_grid(1:3), hash_fmm_cell(1:3)
    integer(kind=4) :: fmm_grid_center_offset(1:3), fmm_cell_center_offset(1:3)
    integer(kind=4) :: source_cell_coord(1:3), target_cell_coord(1:3)
    integer(kind=4) :: cc_jcell(1:3), cc_icell(1:3), cell_diff(1:3), cc_jcell_periodic(1:3)
    integer(kind=4) :: offset_grid(1:3), offset_amr(1:3), grid_nbors(1:threetondim)
    integer(kind=4) :: igrid, igrid_parent, igrid_nbor, pcell
    real(kind=dp) :: far_diff(1:3), diff(1:3), dist, D0, D1, D2, phi_out
    real(kind=dp) :: parent_taylor(1:taylor_size), multipole(1:multipole_size)
    logical :: cycle_flag, direct_neighbor, nonzero_multipole

    thread_idx = threadIdx%x - 1
    ioct = thread_idx + (blockIdx%x - 1) * blockDim%x
    if (ioct >= num_octs) return
    ioct = head_idx + ioct

    if (reset_phi) phi_amr(1:twotondim, ioct) = 0.0_dp
    if (all(grid_amr(ioct)%refined(1:twotondim))) return

    nfine = 2**level_fmm_to_amr
    half_nfine = max(1, nfine / 2)
    fmm_level = ilev - level_fmm_to_amr
    fmm_cell_level = fmm_level + 1

    hash_key = 0
    hash_fmm_grid = 0
    hash_fmm_cell = 0
    fmm_grid_center_offset = 0
    fmm_cell_center_offset = 0
    igrid = 1
    do idim = 1, ndim
       hash_key(idim) = grid_amr(ioct)%ckey(idim)
       hash_fmm_grid(idim) = hash_key(idim) / nfine
       hash_fmm_cell(idim) = hash_key(idim) / half_nfine
       fmm_grid_center_offset(idim) = mod(hash_key(idim), nfine) - (nfine / 2)
       fmm_cell_center_offset(idim) = 2 * mod(fmm_grid_center_offset(idim) + (nfine / 2), half_nfine) - (nfine / 2)
       igrid = igrid + nfine**(idim-1) * mod(hash_key(idim), nfine)
    end do

    if (ilev == jlev) then
       igrid_parent = lookup_grid_by_ckey(hash_fmm_grid, fmm_level, hash_key_source, hash_val_source, &
            & hash_size_source, ckey_max, key_off)
       pcell = 1
       do idim = 1, ndim
          pcell = pcell + 2**(idim-1) * mod(hash_fmm_cell(idim), 2)
       end do
       parent_taylor = 0.0_dp
       if (igrid_parent > 0) parent_taylor = taylor_source(pcell, 1:taylor_size, igrid_parent)

       do icell = 1, twotondim
          if (grid_amr(ioct)%refined(icell)) cycle
          far_diff = 0.0_dp
          do idim = 1, ndim
             nstride = 2**(idim-1)
             far_diff(idim) = (real(fmm_cell_center_offset(idim), kind=dp) + &
                  & real(mod((icell-1)/nstride, 2), kind=dp) + 0.5_dp) * dx_loc
          end do
          call fmm_calc_phi(parent_taylor, far_diff, phi_out)
          phi_amr(icell, ioct) = phi_amr(icell, ioct) + phi_out
       end do
    end if

    call get_intermediate_nbor_grid_device(hash_key_source, hash_val_source, hash_size_source, &
         & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, hash_fmm_cell, fmm_cell_level, grid_nbors)

    do inbor = 1, threetondim
       do idim = 1, ndim
          offset_grid(idim) = mod((inbor-1)/3**(idim-1), 3) - 1
       end do

       igrid_nbor = grid_nbors(inbor)
       if (igrid_nbor <= 0) cycle

       do jcell = 1, twotondim
          multipole = multipole_source(jcell, 1:multipole_size, igrid_nbor)
          nonzero_multipole = .false.
          do q = 1, multipole_size
             nonzero_multipole = nonzero_multipole .or. multipole(q) /= 0.0_dp
          end do
          if (.not. nonzero_multipole) cycle

          source_cell_coord = 0
          cc_jcell = 0
          offset_amr = 0
          do idim = 1, ndim
             nstride = 2**(idim-1)
             source_cell_coord(idim) = mod((jcell-1)/nstride, 2)
             cc_jcell(idim) = 2 * offset_grid(idim) + source_cell_coord(idim)
             offset_amr(idim) = (2 * cc_jcell(idim) + 1) * half_nfine
          end do

          direct_neighbor = .true.
          cell_diff = 0
          do idim = 1, ndim
             target_cell_coord(idim) = (fmm_grid_center_offset(idim) + (nfine / 2)) / half_nfine
             cell_diff(idim) = target_cell_coord(idim) - cc_jcell(idim)
             if (abs(cell_diff(idim)) > 1) direct_neighbor = .false.
          end do
          if (direct_neighbor) cycle

          cycle_flag = .false.
          do idim = 1, ndim
             cc_jcell_periodic(idim) = hash_fmm_cell(idim) - cell_diff(idim)
             if (cc_jcell_periodic(idim) < box_ckey_min(idim, fmm_cell_level) .or. &
                 cc_jcell_periodic(idim) >= box_ckey_max(idim, fmm_cell_level)) then
                cycle_flag = .true.
             end if
          end do
          if (cycle_flag) cycle

          do icell = 1, twotondim
             if (grid_amr(ioct)%refined(icell)) cycle
             diff = 0.0_dp
             do idim = 1, ndim
                nstride = 2**(idim-1)
                cc_icell(idim) = 2 * fmm_grid_center_offset(idim) + mod((icell-1)/nstride, 2)
                diff(idim) = (real(cc_icell(idim), kind=dp) + 0.5_dp - &
                     & real(offset_amr(idim), kind=dp) + real(nfine, kind=dp)) * dx_loc
             end do
             dist = sqrt(sum(diff(1:ndim)**2))
             D0 = 1.0_dp / dist
             D1 = -1.0_dp / dist**3
             D2 = 3.0_dp / dist**5
             call fmm_calc_phi_from_multipole(diff, D0, D1, D2, multipole, phi_out)
             phi_amr(icell, ioct) = phi_amr(icell, ioct) + phi_out
          end do
       end do
    end do

  end subroutine fmm_amr_intermediate_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_amr_direct_kernel(grid_amr, rho_amr, phi_amr, hash_key_amr, hash_val_amr, &
       & hash_size_amr, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_octs, &
       & ilev, level_fmm_to_amr, dx_loc, dxn)
    type(oct), device :: grid_amr(*)
    real(kind=dp), device :: rho_amr(1:twotondim,*), phi_amr(1:twotondim,*)
    integer(kind=8), device :: hash_key_amr(*)
    integer(kind=4), device :: hash_val_amr(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
    logical, device :: periodic(1:3)
    integer(kind=4), value :: hash_size_amr, head_idx, num_octs, ilev, level_fmm_to_amr
    real(kind=dp), value :: dx_loc, dxn

    integer :: thread_idx, ioct, idim, icell, jcell, jgrid, jfinecell, inbor, nstride
    integer(kind=4) :: nfine, half_nfine, nbox
    integer(kind=4) :: hash_target(1:3), hash_fmm_cell(1:3), target_grid_coord(1:3)
    integer(kind=4) :: offset(1:3), cc_fmm_cell(1:3), local_grid_coord(1:3)
    integer(kind=4) :: hash_direct(1:3), hash_fine(1:3), source_cell_coord(1:3), fine_cell_coord(1:3)
    integer(kind=4) :: cc_igrid(1:3), cc_jgrid(1:3), cc_icell(1:3), cc_jcell(1:3)
    integer(kind=4) :: igrid, igrid_nbor, igrid_fine
    real(kind=dp) :: diff(1:3), fine_diff(1:3), dist, inv_dist, phi_accum
    logical :: in_domain, source_all_refined, direct_neighbor, same_cell

    thread_idx = threadIdx%x - 1
    ioct = thread_idx + (blockIdx%x - 1) * blockDim%x
    if (ioct >= num_octs) return
    ioct = head_idx + ioct

    if (all(grid_amr(ioct)%refined(1:twotondim))) return

    nfine = 2**level_fmm_to_amr
    half_nfine = max(1, nfine / 2)
    nbox = half_nfine**ndim

    hash_target = 0
    hash_fmm_cell = 0
    target_grid_coord = 0
    igrid = 1
    do idim = 1, ndim
       hash_target(idim) = grid_amr(ioct)%ckey(idim)
       hash_fmm_cell(idim) = hash_target(idim) / half_nfine
       target_grid_coord(idim) = mod(hash_target(idim), half_nfine)
       igrid = igrid + half_nfine**(idim-1) * target_grid_coord(idim)
    end do

    do icell = 1, twotondim
       if (grid_amr(ioct)%refined(icell)) cycle

       cc_igrid = target_grid_coord
       cc_icell = 0
       do idim = 1, ndim
          nstride = 2**(idim-1)
          cc_icell(idim) = 2 * cc_igrid(idim) + mod((icell-1)/nstride, 2)
       end do

       phi_accum = 0.0_dp
       do inbor = 1, threetondim
          do idim = 1, ndim
             offset(idim) = mod((inbor-1)/3**(idim-1), 3) - 1
             cc_fmm_cell(idim) = hash_fmm_cell(idim) + offset(idim)
          end do

          do jgrid = 1, nbox
             local_grid_coord = 0
             hash_direct = 0
             cc_jgrid = 0
             do idim = 1, ndim
                nstride = half_nfine**(idim-1)
                local_grid_coord(idim) = mod((jgrid-1)/nstride, half_nfine)
                hash_direct(idim) = half_nfine * cc_fmm_cell(idim) + local_grid_coord(idim)
                cc_jgrid(idim) = offset(idim) * half_nfine + local_grid_coord(idim)
             end do

             call wrap_grid_ckey(hash_direct, ilev, box_ckey_min, box_ckey_max, periodic, in_domain)
             if (.not. in_domain) cycle

             igrid_nbor = lookup_grid_by_ckey(hash_direct, ilev, hash_key_amr, hash_val_amr, &
                  & hash_size_amr, ckey_max, key_off)
             if (igrid_nbor <= 0) cycle

             source_all_refined = all(grid_amr(igrid_nbor)%refined(1:twotondim))
             if (source_all_refined) then
                do jcell = 1, twotondim
                   source_cell_coord = 0
                   cc_jcell = 0
                   direct_neighbor = .true.
                   do idim = 1, ndim
                      nstride = 2**(idim-1)
                      source_cell_coord(idim) = mod((jcell-1)/nstride, 2)
                      cc_jcell(idim) = 2 * cc_jgrid(idim) + source_cell_coord(idim)
                      if (abs(cc_icell(idim) - cc_jcell(idim)) > 1) direct_neighbor = .false.
                   end do
                   if (.not. direct_neighbor) cycle

                   hash_fine = 0
                   do idim = 1, ndim
                      hash_fine(idim) = 2 * hash_direct(idim) + source_cell_coord(idim)
                   end do
                   igrid_fine = lookup_grid_by_ckey(hash_fine, ilev+1, hash_key_amr, hash_val_amr, &
                        & hash_size_amr, ckey_max, key_off)
                   if (igrid_fine <= 0) cycle

                   diff = 0.0_dp
                   do idim = 1, ndim
                      diff(idim) = real(cc_icell(idim) - cc_jcell(idim), kind=dp) * dx_loc
                   end do

                   do jfinecell = 1, twotondim
                      fine_diff = diff
                      do idim = 1, ndim
                         nstride = 2**(idim-1)
                         fine_cell_coord(idim) = mod((jfinecell-1)/nstride, 2)
                         fine_diff(idim) = fine_diff(idim) + &
                              & 0.5_dp * (real(fine_cell_coord(idim), kind=dp) - 0.5_dp) * dx_loc
                      end do
                      dist = sqrt(sum(fine_diff(1:ndim)**2))
                      if (dist > 0.0_dp) then
                         phi_accum = phi_accum - rho_amr(jfinecell, igrid_fine) * dxn / real(twotondim, kind=dp) / dist
                      end if
                   end do
                end do
             else
                do jcell = 1, twotondim
                   cc_jcell = 0
                   same_cell = .true.
                   diff = 0.0_dp
                   do idim = 1, ndim
                      nstride = 2**(idim-1)
                      source_cell_coord(idim) = mod((jcell-1)/nstride, 2)
                      cc_jcell(idim) = 2 * cc_jgrid(idim) + source_cell_coord(idim)
                      same_cell = same_cell .and. cc_icell(idim) == cc_jcell(idim)
                      diff(idim) = real(cc_icell(idim) - cc_jcell(idim), kind=dp) * dx_loc
                   end do
                   if (same_cell) then
                      inv_dist = 1.0_dp / dx_loc
                   else
                      inv_dist = 1.0_dp / sqrt(sum(diff(1:ndim)**2))
                   end if
                   phi_accum = phi_accum - rho_amr(jcell, igrid_nbor) * dxn * inv_dist
                end do
             end if
          end do
       end do

       phi_amr(icell, ioct) = phi_amr(icell, ioct) + phi_accum
    end do

  end subroutine fmm_amr_direct_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_amr_direct_taylor_kernel(grid_amr, phi_amr, grid_source, multipole_source, &
       & hash_key_source, hash_val_source, hash_size_source, ckey_max, key_off, box_ckey_min, box_ckey_max, &
       & periodic, head_idx, num_octs, ilev, level_fmm_to_amr, dx_loc)
    type(oct), device :: grid_amr(*), grid_source(*)
    real(kind=dp), device :: phi_amr(1:twotondim,*)
    real(kind=dp), device :: multipole_source(1:twotondim,1:multipole_size,*)
    integer(kind=8), device :: hash_key_source(*)
    integer(kind=4), device :: hash_val_source(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
    logical, device :: periodic(1:3)
    integer(kind=4), value :: hash_size_source, head_idx, num_octs, ilev, level_fmm_to_amr
    real(kind=dp), value :: dx_loc

    integer :: thread_idx, ioct, idim, icell, jcell, jgrid, inbor, q, nstride
    integer(kind=4) :: nfine, half_nfine, nbox
    integer(kind=4) :: hash_target(1:3), hash_fmm_cell(1:3), target_grid_coord(1:3)
    integer(kind=4) :: offset(1:3), cc_fmm_cell(1:3), local_grid_coord(1:3), hash_direct(1:3)
    integer(kind=4) :: source_cell_coord(1:3), cc_igrid(1:3), cc_jgrid(1:3), cc_icell(1:3), cc_jcell(1:3)
    integer(kind=4) :: igrid_source
    real(kind=dp) :: diff(1:3), dist, D0, D1, D2, phi_out, phi_accum
    real(kind=dp) :: multipole(1:multipole_size)
    logical :: in_domain, direct_neighbor, nonzero_multipole, same_cell

    thread_idx = threadIdx%x - 1
    ioct = thread_idx + (blockIdx%x - 1) * blockDim%x
    if (ioct >= num_octs) return
    ioct = head_idx + ioct

    if (all(grid_amr(ioct)%refined(1:twotondim))) return

    nfine = 2**level_fmm_to_amr
    half_nfine = max(1, nfine / 2)
    nbox = half_nfine**ndim

    hash_target = 0
    hash_fmm_cell = 0
    target_grid_coord = 0
    do idim = 1, ndim
       hash_target(idim) = grid_amr(ioct)%ckey(idim)
       hash_fmm_cell(idim) = hash_target(idim) / half_nfine
       target_grid_coord(idim) = mod(hash_target(idim), half_nfine)
    end do

    do icell = 1, twotondim
       if (grid_amr(ioct)%refined(icell)) cycle

       cc_igrid = target_grid_coord
       cc_icell = 0
       do idim = 1, ndim
          nstride = 2**(idim-1)
          cc_icell(idim) = 2 * cc_igrid(idim) + mod((icell-1)/nstride, 2)
       end do

       phi_accum = 0.0_dp
       do inbor = 1, threetondim
          do idim = 1, ndim
             offset(idim) = mod((inbor-1)/3**(idim-1), 3) - 1
             cc_fmm_cell(idim) = hash_fmm_cell(idim) + offset(idim)
          end do

          do jgrid = 1, nbox
             local_grid_coord = 0
             hash_direct = 0
             cc_jgrid = 0
             do idim = 1, ndim
                nstride = half_nfine**(idim-1)
                local_grid_coord(idim) = mod((jgrid-1)/nstride, half_nfine)
                hash_direct(idim) = half_nfine * cc_fmm_cell(idim) + local_grid_coord(idim)
                cc_jgrid(idim) = offset(idim) * half_nfine + local_grid_coord(idim)
             end do

             call wrap_grid_ckey(hash_direct, ilev, box_ckey_min, box_ckey_max, periodic, in_domain)
             if (.not. in_domain) cycle

             igrid_source = lookup_grid_by_ckey(hash_direct, ilev, hash_key_source, hash_val_source, &
                  & hash_size_source, ckey_max, key_off)
             if (igrid_source <= 0) cycle

             do jcell = 1, twotondim
                multipole = multipole_source(jcell, 1:multipole_size, igrid_source)
                nonzero_multipole = .false.
                do q = 1, multipole_size
                   nonzero_multipole = nonzero_multipole .or. multipole(q) /= 0.0_dp
                end do
                if (.not. nonzero_multipole) cycle

                cc_jcell = 0
                direct_neighbor = .true.
                same_cell = .true.
                diff = 0.0_dp
                do idim = 1, ndim
                   nstride = 2**(idim-1)
                   source_cell_coord(idim) = mod((jcell-1)/nstride, 2)
                   cc_jcell(idim) = 2 * cc_jgrid(idim) + source_cell_coord(idim)
                   if (abs(cc_icell(idim) - cc_jcell(idim)) > 1) direct_neighbor = .false.
                   same_cell = same_cell .and. cc_icell(idim) == cc_jcell(idim)
                   diff(idim) = real(cc_icell(idim) - cc_jcell(idim), kind=dp) * dx_loc
                end do
                if (direct_neighbor .or. same_cell) cycle

                dist = sqrt(sum(diff(1:ndim)**2))
                D0 = 1.0_dp / dist
                D1 = -1.0_dp / dist**3
                D2 = 3.0_dp / dist**5
                call fmm_calc_phi_from_multipole(diff, D0, D1, D2, multipole, phi_out)
                phi_accum = phi_accum + phi_out
             end do
          end do
       end do

       phi_amr(icell, ioct) = phi_amr(icell, ioct) + phi_accum
    end do

  end subroutine fmm_amr_direct_taylor_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine fmm_combined_direct_kernel(grid_amr, rho_amr, phi_amr, hash_key_amr, hash_val_amr, &
       & hash_size_amr, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_octs, &
       & ilev, dx_loc, vol_loc)
    type(oct), device :: grid_amr(*)
    real(kind=dp), device :: rho_amr(1:twotondim,*), phi_amr(1:twotondim,*)
    integer(kind=8), device :: hash_key_amr(*)
    integer(kind=4), device :: hash_val_amr(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
    logical, device :: periodic(1:3)
    integer(kind=4), value :: hash_size_amr, head_idx, num_octs, ilev
    real(kind=dp), value :: dx_loc, vol_loc

    integer :: thread_idx, ioct, idim, ifinecell, jcell, inbor, nstride
    integer(kind=4) :: hash_target(1:3), hash_parent(1:3), parent_cell_coord(1:3)
    integer(kind=4) :: offset_grid(1:3), source_cell_coord(1:3), cc_jcell(1:3), cc_jcell_periodic(1:3)
    integer(kind=4) :: target_cell_coord(1:3), offset_amr(1:3), grid_nbors(1:threetondim), igrid_nbor
    real(kind=dp) :: diff(1:3), dist, phi_accum
    logical :: cycle_flag

    thread_idx = threadIdx%x - 1
    ioct = thread_idx + (blockIdx%x - 1) * blockDim%x
    if (ioct >= num_octs) return
    ioct = head_idx + ioct

    if (all(grid_amr(ioct)%refined(1:twotondim))) return

    hash_target = 0
    hash_parent = 0
    parent_cell_coord = 0
    do idim = 1, ndim
       hash_target(idim) = grid_amr(ioct)%ckey(idim)
       hash_parent(idim) = hash_target(idim) / 2
       parent_cell_coord(idim) = mod(hash_target(idim), 2)
    end do

    call get_threetondim_nbor_grid_device(hash_key_amr, hash_val_amr, hash_size_amr, ckey_max, key_off, &
         & box_ckey_min, box_ckey_max, periodic, hash_parent, ilev-1, grid_nbors)

    do ifinecell = 1, twotondim
       if (grid_amr(ioct)%refined(ifinecell)) cycle

       target_cell_coord = 0
       do idim = 1, ndim
          nstride = 2**(idim-1)
          target_cell_coord(idim) = mod((ifinecell-1)/nstride, 2)
       end do

       phi_accum = 0.0_dp
       do inbor = 1, threetondim
          do idim = 1, ndim
             offset_grid(idim) = mod((inbor-1)/3**(idim-1), 3) - 1
          end do

          igrid_nbor = grid_nbors(inbor)
          if (igrid_nbor <= 0) cycle

          do jcell = 1, twotondim
             cycle_flag = .false.
             source_cell_coord = 0
             cc_jcell = 0
             cc_jcell_periodic = 0
             offset_amr = 0
             do idim = 1, ndim
                nstride = 2**(idim-1)
                source_cell_coord(idim) = mod((jcell-1)/nstride, 2)
                cc_jcell(idim) = 2 * offset_grid(idim) + source_cell_coord(idim)
                offset_amr(idim) = 2 * cc_jcell(idim) + 1
                cc_jcell_periodic(idim) = 2 * grid_amr(igrid_nbor)%ckey(idim) + source_cell_coord(idim)
                if (cc_jcell_periodic(idim) < box_ckey_min(idim, ilev) .or. &
                    cc_jcell_periodic(idim) >= box_ckey_max(idim, ilev)) then
                   cycle_flag = .true.
                end if
             end do
             if (cycle_flag) cycle
             if (grid_amr(igrid_nbor)%refined(jcell)) cycle

             diff = 0.0_dp
             do idim = 1, ndim
                diff(idim) = (2.0_dp * real(parent_cell_coord(idim), kind=dp) + &
                     & real(target_cell_coord(idim), kind=dp) - real(offset_amr(idim), kind=dp) + 0.5_dp) * dx_loc
             end do
             dist = sqrt(sum(diff(1:ndim)**2))
             phi_accum = phi_accum - rho_amr(jcell, igrid_nbor) * vol_loc / dist
          end do
       end do

       phi_amr(ifinecell, ioct) = phi_amr(ifinecell, ioct) + phi_accum
    end do

  end subroutine fmm_combined_direct_kernel
  ! =========================================================================

end module fmm_device
