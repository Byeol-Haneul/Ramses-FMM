module gpu_runner
  use amr_parameters, only: ndim, twotondim, threetondim, dp, i8b, multipole_size, taylor_size
  use hydro_parameters, only: nvar
  use oct_commons, only: oct
  use gpu_utils
  use cudafor
  implicit none
  integer, dimension(1:3), parameter::n_nbor = (/1,2,2/)

  !> Various parameters on the device
  logical, device, dimension(1:3) :: periodic
  real(kind=8), device, dimension(1:3) :: box_size
  real(kind=8), device, dimension(1:3) :: constant_gravity
  real(kind=8), device, dimension(1:multipole_size) :: gravity_multipole
  integer(kind=4), device, allocatable, dimension(:) :: ckey_max
  integer(kind=8), device, allocatable, dimension(:) :: key_off
  integer(kind=4), device, allocatable, dimension(:,:) :: box_ckey_min, box_ckey_max
  integer(kind=4), device, allocatable, dimension(:,:,:) :: bound_ckey_min, bound_ckey_max

  !> Arrays to hold the grid on the device
  type(oct), device, allocatable, dimension(:) :: grid
  integer(kind=4), device, allocatable, dimension(:) :: father
  integer(kind=4), device, allocatable, dimension(:,:) :: nbor
  integer(kind=4), device, allocatable, dimension(:,:) :: flag1, flag2

  !> Arrays to hold the hydro variables on the device
  real(kind=dp), device, allocatable, dimension(:,:,:) :: uold, unew

  !> Arrays to hold the gravity variables on the device
  real(kind=dp), device, allocatable, dimension(:,:) :: phi, rho, nref, phi_old
  real(kind=dp), device, allocatable, dimension(:,:,:) :: f

  !> Arrays to hold the dark matter particle variables on the device
  real(kind=dp),   device, allocatable, dimension(:,:) :: xp, vp
  real(kind=dp),   device, allocatable, dimension(:)   :: mp, phip
  integer(kind=4), device, allocatable, dimension(:)   :: levelp
  integer(kind=4), device, allocatable, dimension(:)   :: sortp
  integer(i8b),    device, allocatable, dimension(:)   :: idp

!!$  real(kind=dp),   device, allocatable, dimension(:,:) :: jp
!!$  real(kind=dp),   device, allocatable, dimension(:)   :: zp, tp, tm, size_p, charge
!!$  integer(i8b),    device, allocatable, dimension(:)   :: idm
!!$  integer(kind=4), device, allocatable, dimension(:)   :: idt

  !> xp_swap/isp_swap/idp_swap: gather/scatter scratch and other tasks.
  real(kind=dp),   device, allocatable, dimension(:) :: xp_swap
  integer(kind=8), device, allocatable, dimension(:) :: idp_swap
  integer(kind=4), device, allocatable, dimension(:) :: isp_swap

  !> Arrays to hold the hash table on the device
  integer(kind=8), device, allocatable, dimension(:) :: hash_key
  integer(kind=4), device, allocatable, dimension(:) :: hash_val

  !> Object to hold the prefix sum data vector and workspace
  integer(kind=4), device, allocatable, dimension(:) :: swap_local, swap_global
  integer(kind=4), device, allocatable, dimension(:) :: prefix_sum
  integer(kind=4), device, allocatable, dimension(:) :: partial_sums_0, partial_sums_1, partial_sums_2

  !> Arrays to hold the multigrid variables on the device
  type(oct), device, allocatable, dimension(:) :: grid_mg
  integer(kind=4), device, allocatable, dimension(:) :: father_mg
  integer(kind=4), device, allocatable, dimension(:,:) :: nbor_mg
  real(kind=dp), device, allocatable, dimension(:,:,:) :: f_mg
  real(kind=dp), device, allocatable, dimension(:,:) :: phi_mg
  integer(kind=8), device, allocatable, dimension(:) :: hash_key_mg
  integer(kind=4), device, allocatable, dimension(:) :: hash_val_mg

  !> Arrays to hold the FMM variables on the device
  type(oct), device, allocatable, dimension(:) :: grid_fmm
  integer(kind=4), device, allocatable, dimension(:) :: father_fmm
  integer(kind=4), device, allocatable, dimension(:) :: source_parent_fmm
  integer(kind=4), device, allocatable, dimension(:) :: source_grid_fmm
  integer(kind=4), device, allocatable, dimension(:,:) :: nbor_fmm
  real(kind=dp), device, allocatable, dimension(:,:,:) :: multipole_fmm, taylor_fmm
  real(kind=dp), device, dimension(1:multipole_size) :: fmm_global_multipole
  integer(kind=8), device, allocatable, dimension(:) :: hash_key_fmm
  integer(kind=4), device, allocatable, dimension(:) :: hash_val_fmm
  integer(kind=4) :: fmm_grid_capacity = 0
  integer(kind=4) :: fmm_father_capacity = 0
  integer(kind=4) :: fmm_father_amr_capacity = 0
  integer(kind=4) :: fmm_father_grid_offset = 0
  integer(kind=4) :: fmm_source_parent_capacity = 0
  integer(kind=4) :: fmm_hash_capacity = 0
  integer(kind=4), allocatable, dimension(:) :: fmm_grid_offset, fmm_grid_capacity_slot
  integer(kind=4), allocatable, dimension(:) :: fmm_hash_offset, fmm_hash_capacity_slot
  integer(kind=4) :: fmm_slot_levelmin = 0
  integer(kind=4) :: fmm_slot_levelmax = -1
  integer(kind=4) :: fmm_merged_slot = -1
  logical :: fmm_distance_tables_initialized = .false.
  logical :: fmm_amr_lookup_valid = .false.

  !> The Fortran array of hydro variables of ghost and halo octs on the host and on the device
  real(kind=dp), allocatable, dimension(:) :: uold_send_host, uold_recv_host
  real(kind=dp), device, allocatable, dimension(:) :: uold_send_device, uold_recv_device

  !> The Fortran array of oct index of ghost and halo octs on the host and the device
  integer, allocatable, dimension(:) :: idx_send_host, idx_recv_host
  integer, device, allocatable, dimension(:) :: idx_send_device, idx_recv_device

  !> The Fortran array of the hash keys of ghost and halo octs on the host only
  integer, allocatable, dimension(:) :: key_send_host, key_recv_host

  !> The number of halo and ghost octs per cpu
  integer, allocatable, dimension(:) :: n_send, n_recv

  !> The total number of halo and ghost octs
  integer(kind=4) :: num_send, num_recv

contains

  include 'gpu_scan.cuf'

  !> @brief
  !> Compute the new time step on a GPU
  !>
  !> @detail
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_cmpdt(sim, ilevel, mass, ekin, eint, emag, dt)
    use nvtx
    use hydro_device, only: cmpdt_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer(kind=4), intent(in) :: ilevel
    real(kind=8), intent(inout) :: mass, ekin, eint, emag, dt

    integer(kind=4) :: head_idx, num_octs
    integer :: num_threads, num_blocks
    real(kind=dp) :: gamma, dx, courant_factor
    real(kind=8), device :: mass_d, ekin_d, eint_d, emag_d, dt_d

    courant_factor = sim%r%courant_factor
    gamma = sim%r%gamma
    dx = sim%r%boxlen/2**ilevel
    dt = courant_factor*dx/sim%r%smallc

    ! host to device
    dt_d = dt
    mass_d = 0d0
    ekin_d = 0d0
    eint_d = 0d0
    emag_d = 0d0

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads
    call nvtxStartRange("GPU cmpdt", color=0)!green
    call cmpdt_kernel<<<num_blocks, num_threads>>>(grid, uold, f, constant_gravity, head_idx, num_octs, &
         & mass_d, ekin_d, eint_d, emag_d, dt_d, dx, gamma, courant_factor)
    call nvtxEndRange()

    ! device to host
    dt = dt_d
    mass = mass_d
    ekin = ekin_d
    eint = eint_d
    emag = emag_d

  end subroutine gpu_cmpdt

  !> @brief
  !> Set uold equal to unew on a GPU
  !>
  !> @detail
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_set_uold(sim, ilevel)
    use nvtx
    use hydro_device, only: set_uold_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_blocks

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    call nvtxStartRange("GPU Set_uold", color=0)!green
    call set_uold_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(uold, unew, head_idx, num_octs)
    call nvtxEndRange()

  end subroutine gpu_set_uold

  !> @brief
  !> Set unew equal to uold on a GPU
  !>
  !> @detail
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_set_unew(sim, ilevel)
    use nvtx
    use hydro_device, only: set_unew_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_blocks

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    call nvtxStartRange("GPU Set_unew", color=0)!green
    call set_unew_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(uold, unew, head_idx, num_octs)
    call nvtxEndRange()

  end subroutine gpu_set_unew

  !> @brief
  !> Synchronization (corrector) step of old hydro variables (uold) due to gravity
  !>
  !> @detail
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_sync_hydro(sim, ilevel, dt)
    use nvtx
    use hydro_device, only: sync_hydro
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel
    real(kind=8) :: dt

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_blocks
    real(kind=dp) :: gamma

    gamma = real(sim%r%gamma, kind=dp)

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    call nvtxStartRange("GPU sync_hydro", color=0)!green
    call sync_hydro<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(uold, f, constant_gravity, &
         & head_idx, num_octs, gamma, dt)
    call nvtxEndRange()

  end subroutine gpu_sync_hydro

  !> @brief
  !> Predictor step of new hydro variables (unew) due to gravity
  !>
  !> @detail
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_grav_hydro(sim, ilevel)
    use nvtx
    use hydro_device, only: grav_hydro
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_blocks
    real(kind=8) :: dt
    real(kind=dp) :: gamma

    dt = 0.5 * sim%g%dtnew(ilevel)
    gamma = real(sim%r%gamma, kind=dp)

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    call nvtxStartRange("GPU grav_hydro", color=0)!green
    call grav_hydro<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(uold, unew, f, constant_gravity, &
         & head_idx, num_octs, gamma, dt)
    call nvtxEndRange()

  end subroutine gpu_grav_hydro

  !> @brief
  !> Perform the hydro integration on a GPU
  !>
  !> @detail
  !> Perform the hydro integration on the GPU with the following steps
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_godunov(sim, ilevel)
    use nvtx
    use hydro_device, only: hydro_integrator_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel
    !
    integer(kind=4) :: head_idx, num_subgrids
    integer :: threads_per_block, num_blocks
    real(dp) :: dt, dx, gamma
    integer :: slope, riemann

    if(sim%r%verbose.and.sim%g%myid==1)write(*,'("   Entering gpu_godunov for level ",I2)')ilevel

    dt = sim%g%dtnew(ilevel)
    dx = sim%r%boxlen/2**ilevel
    gamma = sim%r%gamma
    slope = sim%r%slope_type
    riemann = sim%r%riemann

    head_idx = (sim%m%head(ilevel) - 1) / nsubgridtondim + 1
    num_subgrids = sim%m%noct(ilevel) / nsubgridtondim
    num_blocks = num_subgrids
    if(nsubgrid == 1)then
       threads_per_block = 64
    else
       threads_per_block = 256
    endif

    call nvtxStartRange("GPU Godunov", color=0)!green
    call hydro_integrator_kernel<<<num_blocks, threads_per_block>>>(grid, uold, unew, f, father, nbor, &
         & head_idx, num_subgrids, sim%m%ngridmax, ilevel, sim%r%levelmin, sim%r%nlevelmax, &
         & gamma, dt, dx, slope, riemann, constant_gravity)
    call nvtxEndRange()

  end subroutine gpu_godunov

  !> @brief
  !> Restriction of fine cells hydro variable into the coarse level
  !>
  !> @detail
  !> Average conservatively the 8 fine children cells hydro variables into the parent coarse cell.
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_upload(sim, ilevel)
    use nvtx
    use hydro_device, only: upload_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel
    !
    integer(kind=4) :: head_idx, num_octs
    integer(kind=4) :: num_threads, num_blocks

    head_idx = sim%m%head(ilevel+1)
    num_octs = sim%m%noct(ilevel+1)
    num_threads = 256
    num_blocks = (num_octs + num_threads - 1) / num_threads

    if (num_octs > 0) then
       call nvtxStartRange("GPU upload", color=0)!green
       call upload_kernel<<<num_blocks, num_threads>>>(grid, father, uold, head_idx, num_octs)
       call nvtxEndRange()
    endif

  end subroutine gpu_upload

  !> @brief
  !> Cooling and polytrope routine
  !>
  !> @detail
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_cooling(sim, ilevel)
    use nvtx
    use cooling_device, only: cooling_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs
    integer(kind=4) :: threadsX_per_block, threadsY_per_block, num_blocks
    real(kind=8) :: scale_nH, scale_T2, scale_l, scale_d, scale_t, scale_v

    ! Conversion factor from user units to cgs units
    call units(sim%r,sim%g,scale_l,scale_t,scale_d,scale_v,scale_nH,scale_T2)

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    if (num_octs > 0) then
       call nvtxStartRange("GPU cooling", color=0)!green
       call cooling_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(uold, grid, &
            & head_idx, num_octs, &
            & sim%r%gamma, sim%g%dtnew(ilevel), sim%r%eos_type, sim%r%eos_T2, sim%r%eos_nH, sim%r%eos_index, &
            & scale_T2, scale_nH)
       call nvtxEndRange()
    end if

  end subroutine gpu_cooling

! gpu_refine
! fused kernels and cub inclusive sum
! undefine these to go back to the original implementation
#undef FUSE_LEVEL
#undef FUSE_HILBERT
#undef FUSE_CACHE
#undef FUSE_SCATTER_GATHER
#undef CUB_SCAN

  !> @brief
  !> This routine deals with AMR refinements and de-refinements on the GPU.
  !>
  !> @detail
  !> It also update the hash table, nbor and father arrays and deals
  !> with the cache.
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_refine(sim, ilevel, nmake, nkill)
    use cudafor
    use nvtx
    use refine_device
    use ramses_commons, only: ramses_t
    use cache_commons
    use cache
    use cub_inclusive_scan_mod
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(out) :: nmake, nkill
    !
    integer(kind=4) :: head_idx, num_octs, num_subgrids
    integer(kind=4) :: head_cache, info
    integer(kind=4) :: num_blocks, num_threads, num_blocks_2
    integer(kind=4) :: threadsX_per_block, threadsY_per_block
    integer(kind=4) :: new_ifree, old_ifree, new_head, new_tail, new_noct
    integer(kind=4) :: ilev, ind, ibit, ibucket, skip_bit, noct_level

    integer(kind=4), device :: ifree_d, ifree_cache_d, new_noct_d
    character(len=64) :: descr

    ! Wipe clean cache memory for all higher levels
    head_cache = sim%m%head_cache(ilevel+1)
    head_idx = head_cache + sim%r%ngridmax
    num_octs = sim%m%ifree_cache - head_cache
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call free_hash_kernel<<<num_blocks, num_threads>>>(grid, hash_key, hash_val, sim%m%hash_size, &
            & ckey_max, key_off, head_idx, num_octs)
    endif
    sim%m%ifree_cache = head_cache

    ! Copy host free memory pointer to device variable
    ifree_d = sim%m%ifree

    ! Create new octs and put them at the end
    head_idx = sim%m%head(ilevel)
    old_ifree = sim%m%ifree
    num_octs = old_ifree - head_idx
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call refine_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(grid, flag1, &
            & uold, f, phi, phi_old, &
            & ifree_d, head_idx, num_octs)
    endif

    ! Copy back to host new free memory pointer ifree
    sim%m%ifree = ifree_d

    ! Compute new octs
    new_ifree = sim%m%ifree
    nmake = new_ifree - old_ifree

    ! Check we have enough memory
    if (new_ifree > sim%r%ngridmax) then
       write(*,*)'No more main memory, increase ngridmax'
       write(*,*)'New octs:', nmake
       stop
    endif

    ! Insert new octs in hash table
    head_idx = old_ifree
    num_octs = new_ifree - old_ifree
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call insert_hash_kernel<<<num_blocks, num_threads>>>(grid, hash_key, hash_val, sim%m%hash_size, &
            & ckey_max, key_off, head_idx, num_octs)
    end if

    ! Remove old octs by setting lev to zero and free their hash table entry
    do ilev = sim%r%nlevelmax, ilevel+1, -1
       head_idx = sim%m%head(ilev)
       num_octs = sim%m%noct(ilev)
       num_threads = 128
       num_blocks = (num_octs + num_threads - 1) / num_threads
       if (num_octs > 0) then
          call derefine_kernel<<<num_blocks, num_threads>>>(grid, flag1, hash_key, hash_val, sim%m%hash_size, &
               & ckey_max, key_off, head_idx, num_octs)
       endif
    end do

    ! Sort remaining octs per level and per Hilbert key

    ! Compute kernel size and offset
    head_idx = sim%m%head(ilevel+1)
    num_octs = new_ifree - head_idx
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads

    ! Init global swap table
    if (num_octs > 0) then
       call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(swap_global, head_idx, num_octs)
    endif

    ! Sort octs per levels using bucket sort

    ! Compute new head
    new_head = sim%m%tail(ilevel)
    new_head = new_head + 1

    do ilev = ilevel+1, sim%r%nlevelmax

       ! Transfer new head
       sim%m%head(ilev) = new_head

       ! Compute kernel size and offset
       head_idx = sim%m%head(ilev)
       num_octs = new_ifree - head_idx
       num_threads = 128
       num_blocks = (num_octs + num_threads - 1) / num_threads

       new_noct = 0

       if (num_octs > 0) then

          write(descr,'(A,I0)'),"sort_oct_lev_",ilev
          call nvtxStartRange(trim(descr), color=2)!yellow

          ! Init prefix sum
          call init_prefix_sum_level<<<num_blocks, num_threads>>>(grid, swap_global, prefix_sum, &
               & head_idx, num_octs, ilev)

          ! Compute prefix sum
#if defined(CUB_SCAN)
          call cub_inclusive_sum(c_loc(prefix_sum), head_idx, num_octs)
#else
          call gpu_scan(head_idx, num_octs, new_noct_d)
#endif
          ! Compute local swap table
          ! Update global swap table
#if defined(FUSE_LEVEL)
          call compute_and_update_swap_table<<<num_blocks, num_threads>>>(swap_local, swap_global, prefix_sum, &
               & head_idx, num_octs, new_noct_d)
#else
          call compute_local_swap_table<<<num_blocks, num_threads>>>(swap_local, swap_global, prefix_sum, &
               & head_idx, num_octs)

          call update_global_swap_table<<<num_blocks, num_threads>>>(swap_global, swap_local, &
               & head_idx, num_octs)
#endif
          ! Compute new noct. note: this results in D-to-H memcpy
          new_noct = new_noct_d
          new_noct = num_octs - new_noct

          call nvtxEndRange()
       endif

       ! Compute new tail and next head
       new_tail = new_head + new_noct - 1
       new_head = new_tail + 1
       sim%m%noct(ilev) = new_noct
       sim%m%tail(ilev) = new_tail

    end do
    sim%m%noct_used=sim%m%tail(sim%r%nlevelmax)

    ! New pointer to free memory
    sim%m%ifree = new_head
    nkill = new_ifree - sim%m%ifree

    ! Sort Hilbert key within each level using LSD radix sort.
    do ilev = ilevel + 1, sim%r%nlevelmax

       if (sim%m%noct(ilev) > 0) then

          ! Compute kernel size and offset
          head_idx = sim%m%head(ilev)
          num_octs = sim%m%noct(ilev)
          num_threads = 128
          num_blocks = (num_octs + num_threads - 1) / num_threads

          ! Loop over Hilbert key bits
          do ibit = 0, ndim * ilev - 1

             write(descr,'(A,I0,A,I0)'),"sort_hilbert_lev_",ilev,"_bit_",ibit
             call nvtxStartRange(trim(descr), color=2)!yellow

             ! Init prefix sum
             call init_prefix_sum_bit<<<num_blocks, num_threads>>>(grid, swap_global, prefix_sum, &
                  & head_idx, num_octs, ibit)

             ! Compute prefix sum
#if defined(CUB_SCAN)
             call cub_inclusive_sum(c_loc(prefix_sum), head_idx, num_octs)
#else
             call gpu_scan(head_idx, num_octs)
#endif
             ! Compute local swap table
             ! Update global swap table
#if defined(FUSE_HILBERT)
             call compute_and_update_swap_table<<<num_blocks, num_threads>>>(swap_local, swap_global, prefix_sum, &
                  & head_idx, num_octs)
#else
             call compute_local_swap_table<<<num_blocks, num_threads>>>(swap_local, swap_global, prefix_sum, &
                  & head_idx, num_octs)

             call update_global_swap_table<<<num_blocks, num_threads>>>(swap_global, swap_local, &
                  & head_idx, num_octs)
#endif
             call nvtxEndRange()
          end do

       endif

    end do

    ! Compute kernel size and offset
    head_idx = sim%m%head(ilevel + 1)
    new_ifree = sim%m%ifree
    num_octs = new_ifree - head_idx
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads

    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks_2 = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    ! Out-of-place sort of grid, flag1, uold and grav variables using swap table
    if (num_octs > 0) then
       call nvtxStartRange("scatter_gather", color=2)!yellow
#if defined(FUSE_SCATTER_GATHER)
       call sort_gather_scatter_grid_flag<<<num_blocks, num_threads>>>(grid, flag1, flag2, swap_global, head_idx, num_octs)
#else
       call sort_gather_grid<<<num_blocks, num_threads>>>(flag2, grid, swap_global, head_idx, num_octs)
       call sort_scatter_grid<<<num_blocks, num_threads>>>(grid, flag2, head_idx, num_octs)
       call sort_gather_flag<<<num_blocks, num_threads>>>(flag2, flag1, swap_global, head_idx, num_octs)
       call sort_scatter_flag<<<num_blocks, num_threads>>>(flag1, flag2, head_idx, num_octs)
#endif
#ifdef HYDRO
       call sort_gather_hydro<<<num_blocks_2, dim3(threadsX_per_block,threadsY_per_block,1)>>>(unew, uold, &
            & swap_global, head_idx, num_octs)
       info = cudaMemcpy(uold(1,1,head_idx), unew(1,1,head_idx), twotondim*nvar*num_octs)
#endif
#ifdef GRAV
#if defined(FUSE_SCATTER_GATHER)
       call sort_gather_scatter_force_phi<<<num_blocks, num_threads>>>(f, phi, phi_old, nref, swap_global, head_idx, num_octs)
#else
       call sort_gather_force<<<num_blocks, num_threads>>>(nref, f, 1, swap_global, head_idx, num_octs)
       call sort_scatter_force<<<num_blocks, num_threads>>>(f, nref, 1, head_idx, num_octs)
       call sort_gather_force<<<num_blocks, num_threads>>>(nref, f, 2, swap_global, head_idx, num_octs)
       call sort_scatter_force<<<num_blocks, num_threads>>>(f, nref, 2, head_idx, num_octs)
       call sort_gather_force<<<num_blocks, num_threads>>>(nref, f, 3, swap_global, head_idx, num_octs)
       call sort_scatter_force<<<num_blocks, num_threads>>>(f, nref, 3, head_idx, num_octs)
       call sort_gather_phi<<<num_blocks, num_threads>>>(nref, phi, swap_global, head_idx, num_octs)
       call sort_scatter_phi<<<num_blocks, num_threads>>>(phi, nref, head_idx, num_octs)
       call sort_gather_phi<<<num_blocks, num_threads>>>(nref, phi_old, swap_global, head_idx, num_octs)
       call sort_scatter_phi<<<num_blocks, num_threads>>>(phi_old, nref, head_idx, num_octs)
#endif
#endif
       call nvtxEndRange()
    endif

    if (num_octs > 0) then

       ! Update hash table
       call update_hash_kernel<<<num_blocks, num_threads>>>(grid, hash_key, hash_val, sim%m%hash_size, &
            & ckey_max, key_off, head_idx, num_octs)

    endif

    info = cudaDeviceSynchronize()
    call m_timer('cache','start')

    if (num_octs > 0) then

       ! Update father index array (they should always exist without MPI)
       call update_father_array<<<num_blocks, num_threads>>>(grid, father, hash_key, hash_val, sim%m%hash_size, &
            & ckey_max, key_off, head_idx, num_octs)

    endif

    ! Update nbor index array level by level
    ! If nbor is absent, make a ghost oct in the cache and insert in hash table

    ! Compute new cache head
    new_head = sim%m%tail_cache(ilevel) + 1

    do ilev = ilevel + 1, sim%r%nlevelmax

       noct_level = sim%m%noct(ilev)
       sim%m%head_cache(ilev) = new_head

       if (noct_level > 0) then

          ! Compute kernel size and offset
          head_idx = (sim%m%head(ilev) - 1) / nsubgridtondim + 1
          num_subgrids = noct_level / nsubgridtondim
          num_threads = 128
          num_blocks = (num_subgrids + num_threads - 1) / num_threads

          ifree_cache_d = sim%m%ifree_cache

          ! Loop over 27 neighbors
          do ind = 1, subgridsize

            write(descr,'(A,I0,A,I0)'),"nbor_refine_lev_",ilev,"ind_",ind
            call nvtxStartRange(trim(descr), color=2)!yellow

             ! Get nbor index from hash table
             call update_nbor_array<<<num_blocks, num_threads>>>(nbor, grid, hash_key, hash_val, &
                  & sim%m%hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
                  & head_idx, num_subgrids, ind, prefix_sum = prefix_sum)

             ! Compute prefix sum
#if defined(CUB_SCAN)
             call cub_inclusive_sum(c_loc(prefix_sum), head_idx, num_subgrids)
#else
             call gpu_scan(head_idx, num_subgrids, new_noct_d)
#endif
             ! Compute cache swap table
             ! Make new ghost octs in cache
             ! Insert new octs in hash table
             ! Increment ifree_cache on device
#if defined(FUSE_CACHE)
             call make_cache_insert_ghost_octs<<<num_blocks, num_threads>>>(grid, flag1, &
                  & uold, f, phi, phi_old, swap_local, prefix_sum, father, nbor, hash_key, &
                  & hash_val, sim%m%hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, &
                  & periodic, sim%m%ngridmax, ifree_cache_d, ind, head_idx, num_subgrids)
#else
#if defined(CUB_SCAN)
             call get_total_sum(prefix_sum, head_idx, num_subgrids, new_noct_d)
#endif
             call compute_cache_swap_table<<<num_blocks, num_threads>>>(swap_local, prefix_sum, &
                  & head_idx, num_subgrids)

             call make_cache_octs<<<num_blocks, num_threads>>>(grid, flag1, &
                  & uold, f, phi, phi_old, swap_local, father, nbor, &
                  & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
                  & sim%m%ngridmax, ifree_cache_d, new_noct_d, ind)

             call insert_hash_cache<<<num_blocks, num_threads>>>(grid, hash_key, hash_val, sim%m%hash_size, &
                  & ckey_max, key_off, sim%m%ngridmax, ifree_cache_d, new_noct_d)

             call advance_ifree_cache<<<1,1>>>(ifree_cache_d, new_noct_d)
#endif
             call nvtxEndRange()

          end do
          ! End loop over 27 nbors

          sim%m%ifree_cache = ifree_cache_d

       end if

       ! Compute new cache tail and next cache head
       new_tail = sim%m%ifree_cache - 1
       sim%m%noct_cache(ilev) = new_tail - new_head + 1
       sim%m%tail_cache(ilev) = new_tail
       new_head = sim%m%ifree_cache

    end do
    ! End loop over levels

    fmm_amr_lookup_valid = .false.
    if (ilevel == sim%r%levelmin) call gpu_reset_hash(sim)

  end subroutine gpu_refine

  !> @brief
  !> Initial step for flagging cells for refinements
  !>
  !> @detail
  !> A cell is flag if it contains a child grid with at least one flagged or refined cell
  !>
  subroutine gpu_init_flag(sim, ilevel, nflag)
    use nvtx
    use flag_device, only: reset_flag1_kernel, init_flag_kernel, count_flag1_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(inout) :: nflag

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks
    integer(kind=8), device :: nflag_d
    integer(kind=8) :: nflag_h

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU init_flag", color=2)!yellow
       call reset_flag1_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(flag1, head_idx, num_octs)
       call nvtxEndRange()
    endif

    head_idx = sim%m%head(ilevel+1)
    num_octs = sim%m%noct(ilevel+1)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU init_flag", color=2)!yellow
       call init_flag_kernel<<<num_blocks, num_threads>>>(flag1, grid, father, head_idx, num_octs)
       call nvtxEndRange()
    endif

    nflag_d = 0

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU init_flag", color=2)!yellow
       call count_flag1_kernel<<<num_blocks, num_threads>>>(flag1, head_idx, num_octs, nflag_d)
       call nvtxEndRange()
    endif

    nflag_h = nflag_d
    nflag = int(nflag_h, kind=4)

  end subroutine gpu_init_flag

  !> @brief
  !> Enforce entire oct to have flag = 1.
  !>
  !> @detail
  !> If one cell is flagged, then flag the entire oct.
  !>
  subroutine gpu_enforce_subgrid(sim, ilevel)
    use nvtx
    use flag_device, only: enforce_subgrid_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: num_threads, num_blocks

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU enforce_subgrid", color=2)!yellow
       call enforce_subgrid_kernel<<<num_blocks, num_threads>>>(flag1, head_idx, num_octs)
       call nvtxEndRange()
    endif

  end subroutine gpu_enforce_subgrid

  !> @brief
  !> User defined refinement criteria
  !>
  !> @detail
  !> Apply several user-defined refinement criteria to flag cells
  !>
  subroutine gpu_user_flag(sim, ilevel, nflag)
    use nvtx
    use hydro_device, only: hydro_flag_kernel
    use flag_device, only: count_flag1_kernel, poisson_flag_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(inout) :: nflag

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks
    real(kind=dp) :: gamma, err_grad_d, err_grad_p, floor_d, floor_p
    real(kind=dp) :: m_refine, jeans_refine, mass_sph, dx, factG
    integer(kind=8), device :: nflag_d
    integer(kind=8) :: nflag_h

    dx = sim%r%boxlen/2**ilevel
    factG = 1
    if (sim%r%cosmo) factG = 3d0 / 8d0 /ACOS(-1d0) * sim%g%omega_m * sim%g%aexp
    gamma = sim%r%gamma
    err_grad_d = sim%r%err_grad_d
    err_grad_p = sim%r%err_grad_p
    floor_d = sim%r%floor_d
    floor_p = sim%r%floor_p
    mass_sph = sim%r%mass_sph
    m_refine = sim%r%m_refine(ilevel)
    jeans_refine = sim%r%jeans_refine(ilevel)

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    if(num_octs > 0)then
       call nvtxStartRange("GPU user_flag", color=2)!yellow
       call poisson_flag_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(flag1, nref, uold, &
            & head_idx, num_octs, gamma, mass_sph, m_refine, jeans_refine, factG, dx)
       call nvtxEndRange()
    endif

    if (sim%r%hydro) then
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       threadsX_per_block = 8
       threadsY_per_block = 16
       num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
       if(num_octs > 0)then
          call nvtxStartRange("GPU user_flag", color=2)!yellow
          call hydro_flag_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(flag1, grid, nbor, uold, &
               & head_idx, num_octs, gamma, err_grad_d, err_grad_p, floor_d, floor_p)
          call nvtxEndRange()
       endif
    endif

    nflag_d = 0

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads

    if (num_octs > 0) then
       call nvtxStartRange("GPU user_flag", color=2)!yellow
       call count_flag1_kernel<<<num_blocks, num_threads>>>(flag1, head_idx, num_octs, nflag_d)
       call nvtxEndRange()
    endif

    nflag_h = nflag_d
    nflag = int(nflag_h, kind=4)

  end subroutine gpu_user_flag

  !> @brief
  !> Smooth refinement map
  !>
  !> @detail
  !> Set flag2 to zero, count neighbors in flag2 and set flag1 to 1 if enough neighbors.
  !>
  subroutine gpu_smooth_flag(sim, ilevel, nflag)
    use nvtx
    use flag_device, only: count_neighbors, flag_count_kernel, count_flag1_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in) :: ilevel
    integer, intent(inout) :: nflag

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks, idim
    integer(kind=8), device :: nflag_d
    integer(kind=8) :: nflag_h

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    if(num_octs > 0)then
       do idim = 1, ndim ! Loop over steps
          call nvtxStartRange("GPU smooth_flag", color=2)!yellow
          call count_neighbors<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(flag2, flag1, nbor, &
               & head_idx, num_octs)
          call flag_count_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(flag1, flag2, &
               & head_idx, num_octs, n_nbor(idim))
          call nvtxEndRange()
       end do
    endif

    nflag_d = 0

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU smooth_flag", color=2)!yellow
       call count_flag1_kernel<<<num_blocks, num_threads>>>(flag1, head_idx, num_octs, nflag_d)
       call nvtxEndRange()
    endif

    nflag_h = nflag_d
    nflag = int(nflag_h, kind=4)

  end subroutine gpu_smooth_flag

  !> @brief
  !> Enforce refinemnt rules
  !>
  !> @detail
  !> Set flag1 to zero if not enough existing neighboring grids
  !>
  subroutine gpu_enforce_rules(sim, ilevel)
    use nvtx
    use flag_device, only: enforce_rules
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: num_threads, num_blocks

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)

    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if(num_octs > 0)then
       call nvtxStartRange("GPU enforce_rules", color=2)!yellow
       call enforce_rules<<<num_blocks, num_threads>>>(flag1, nbor, head_idx, num_octs, sim%m%ngridmax)
       call nvtxEndRange()
    endif

  end subroutine gpu_enforce_rules

  !> @brief
  !> Perform a prefix sum (or a scan) on the input integer array data
  !>
  !> @detail
  !> Perform a prefix scum only starting from index head_idx and over num_octs elements.
  !>
  subroutine gpu_scan(head_idx, num_octs, total_sum)
    integer(kind=4) :: head_idx
    integer(kind=4) :: num_octs
    integer(kind=4), device, optional :: total_sum
    !
    integer(kind=4) :: block_size, grid_size_0, grid_size_1, grid_size_2
    integer(kind=4) :: offset, size
    integer(kind=4) :: num_max_0, num_max_1, num_max_2
    integer(kind=4), device :: total_sum_d

    block_size = 256
    num_max_0 = block_size**2
    num_max_1 = block_size**3
    num_max_2 = huge(1_4)

    if(num_octs <= num_max_0)then

       ! Works only for arrray size smaller or equal than 256^2=65'536
       grid_size_0 = (num_octs + block_size - 1) / block_size
       call block_scan<<<grid_size_0, block_size>>>(prefix_sum, head_idx, num_octs, partial_sums_0, total_sum_d)
       if (grid_size_0 > 1) then
          call block_scan<<<1, grid_size_0>>>(partial_sums_0, 1, grid_size_0)
          offset = head_idx + block_size
          size = num_octs - block_size
          call uniform_add<<<grid_size_0 - 1, block_size>>>(prefix_sum, offset, size, partial_sums_0, total_sum_d)
       end if

    else if(num_octs <= num_max_1)then

       ! Works only for arrray size smaller or equal than 256^3=16'777'216
       grid_size_0 = (num_octs + block_size - 1) / block_size
       call block_scan<<<grid_size_0, block_size>>>(prefix_sum, head_idx, num_octs, partial_sums_0)
       grid_size_1 = (grid_size_0 + block_size - 1) / block_size
       call block_scan<<<grid_size_1, block_size>>>(partial_sums_0, 1, grid_size_0, partial_sums_1)
       if (grid_size_1 > 1) then
          call block_scan<<<1, grid_size_1>>>(partial_sums_1, 1, grid_size_1)
          offset = 1 + block_size
          size = grid_size_0 - block_size
          call uniform_add<<<grid_size_1 - 1, block_size>>>(partial_sums_0, offset, size, partial_sums_1)
       end if
       offset = head_idx + block_size
       size = num_octs - block_size
       call uniform_add<<<grid_size_0 - 1, block_size>>>(prefix_sum, offset, size, partial_sums_0, total_sum_d)

    else if(num_octs <= num_max_2)then

       ! Works only for arrray size smaller or equal than huge(1_4)=2'147'483'647
       grid_size_0 = (num_octs + block_size - 1) / block_size
       call block_scan<<<grid_size_0, block_size>>>(prefix_sum, head_idx, num_octs, partial_sums_0)
       grid_size_1 = (grid_size_0 + block_size - 1) / block_size
       call block_scan<<<grid_size_1, block_size>>>(partial_sums_0, 1, grid_size_0, partial_sums_1)
       grid_size_2 = (grid_size_1 + block_size - 1) / block_size
       call block_scan<<<grid_size_2, block_size>>>(partial_sums_1, 1, grid_size_1, partial_sums_2)
       if (grid_size_2 > 1) then
          call block_scan<<<1, grid_size_2>>>(partial_sums_2, 1, grid_size_2)
          offset = 1 + block_size
          size = grid_size_1 - block_size
          call uniform_add<<<grid_size_2 - 1, block_size>>>(partial_sums_1, offset, size, partial_sums_2)
       end if
       offset = 1 + block_size
       size =  grid_size_0 - block_size
       call uniform_add<<<grid_size_1 - 1, block_size>>>(partial_sums_0, offset, size, partial_sums_1)
       offset = head_idx + block_size
       size = num_octs - block_size
       call uniform_add<<<grid_size_0 - 1, block_size>>>(prefix_sum, offset, size, partial_sums_0, total_sum_d)

    else

       write(*,*)'Too many octs for prefix sum...'
       stop

    endif

    if (present(total_sum)) then
       total_sum = total_sum_d
    endif

  end subroutine gpu_scan

  !> @brief
  !> Initialize the hash table
  !>
  !> @detail
  !> Loop over all existing octs and insert them in the hash table
  !>
  !> @param[in] sim : The simulation object
  !>
  subroutine gpu_reset_hash(sim)
    use nvtx
    use refine_device, only: insert_hash_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    !
    integer(kind=4) :: head_idx, num_octs
    integer :: num_blocks, threads_per_block

    ! Allocate hash tables for the first time
    if(allocated(hash_key))deallocate(hash_key)
    if(allocated(hash_val))deallocate(hash_val)
    allocate(hash_key(1:sim%m%hash_size))
    allocate(hash_val(1:sim%m%hash_size))
    hash_key = 0
    hash_val = 0

    ! Insert entire grid in the device hash table
    head_idx = 1
    num_octs = sim%m%ifree - 1
    threads_per_block = 128
    num_blocks = (num_octs + threads_per_block - 1) / threads_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU reset_hash", color=2)!yellow
       call insert_hash_kernel<<<num_blocks, threads_per_block>>>(grid, hash_key, hash_val, &
            & sim%m%hash_size, ckey_max, key_off, head_idx, num_octs)
       call nvtxEndRange()
    endif

    ! Insert entire cache in the device hash table
    head_idx = sim%r%ngridmax + 1
    num_octs = sim%m%ifree_cache - 1
    threads_per_block = 128
    num_blocks = (num_octs + threads_per_block - 1) / threads_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU reset_hash", color=2)!yellow
       call insert_hash_kernel<<<num_blocks, threads_per_block>>>(grid, hash_key, hash_val, &
            & sim%m%hash_size, ckey_max, key_off, head_idx, num_octs)
       call nvtxEndRange()
    endif

    fmm_amr_lookup_valid = .false.

  end subroutine gpu_reset_hash

  !> @brief
  !> Rebuild the AMR hash with only active oct ranges for FMM hash lookups.
  !>
  !> @detail
  !> The FMM AMR direct path mirrors CPU get_grid semantics: a lookup should
  !> only find octs that are active in the mesh dictionary.  The generic GPU
  !> hash rebuild is left unchanged for MG/refine users.
  !>
  subroutine gpu_reset_hash_fmm_active(sim)
    use nvtx
    use refine_device, only: insert_hash_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim

    integer(kind=4) :: head_idx, num_octs
    integer :: num_blocks, threads_per_block, ilev

    call nvtxStartRange("GPU reset_hash_fmm_active_clear", color=2)!yellow
    if (allocated(hash_key)) then
       if (size(hash_key) /= sim%m%hash_size) deallocate(hash_key)
    end if
    if (allocated(hash_val)) then
       if (size(hash_val) /= sim%m%hash_size) deallocate(hash_val)
    end if
    if (.not. allocated(hash_key)) allocate(hash_key(1:sim%m%hash_size))
    if (.not. allocated(hash_val)) allocate(hash_val(1:sim%m%hash_size))
    hash_key = 0
    hash_val = 0
    call nvtxEndRange()

    threads_per_block = 128

    do ilev = 1, size(sim%m%head)
       head_idx = sim%m%head(ilev)
       num_octs = sim%m%noct(ilev)
       num_blocks = (num_octs + threads_per_block - 1) / threads_per_block
       if (num_octs > 0) then
          call nvtxStartRange("GPU reset_hash_fmm_active", color=2)!yellow
          call insert_hash_kernel<<<num_blocks, threads_per_block>>>(grid, hash_key, hash_val, &
               & sim%m%hash_size, ckey_max, key_off, head_idx, num_octs)
          call nvtxEndRange()
       end if
    end do

    if (allocated(sim%m%head_cache)) then
       do ilev = 1, size(sim%m%head_cache)
          head_idx = sim%m%head_cache(ilev)
          num_octs = sim%m%noct_cache(ilev)
          num_blocks = (num_octs + threads_per_block - 1) / threads_per_block
          if (num_octs > 0) then
             call nvtxStartRange("GPU reset_hash_fmm_active_cache", color=2)!yellow
             call insert_hash_kernel<<<num_blocks, threads_per_block>>>(grid, hash_key, hash_val, &
                  & sim%m%hash_size, ckey_max, key_off, head_idx, num_octs)
             call nvtxEndRange()
          end if
       end do
    end if

  end subroutine gpu_reset_hash_fmm_active

  !> @brief
  !> Refresh same-level AMR neighbors using the FMM active hash.
  !>
  subroutine gpu_refresh_amr_nbor_fmm_active(sim)
    use nvtx
    use refine_device, only: update_nbor_array
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim

    integer(kind=4) :: ilev, ind, head_idx, num_subgrids, num_threads, num_blocks

    num_threads = 128
    do ilev = 1, size(sim%m%head)
       num_subgrids = sim%m%noct(ilev) / nsubgridtondim
       if (num_subgrids <= 0) cycle
       head_idx = (sim%m%head(ilev) - 1) / nsubgridtondim + 1
       num_blocks = (num_subgrids + num_threads - 1) / num_threads
       call nvtxStartRange("GPU refresh_amr_nbor_fmm_active", color=2)!yellow
       do ind = 1, subgridsize
          call update_nbor_array<<<num_blocks, num_threads>>>(nbor, grid, hash_key, hash_val, sim%m%hash_size, &
               & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_subgrids, ind)
       end do
       call nvtxEndRange()
    end do

  end subroutine gpu_refresh_amr_nbor_fmm_active

  !> @brief
  !> Prepare AMR lookup structures used by GPU FMM near-field kernels.
  !>
  subroutine gpu_prepare_fmm_amr_lookup(sim)
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim

    if (sim%r%levelmin == sim%r%nlevelmax) return
    if (fmm_amr_lookup_valid) return

    call gpu_reset_hash_fmm_active(sim)
    call gpu_refresh_amr_nbor_fmm_active(sim)
    fmm_amr_lookup_valid = .true.

  end subroutine gpu_prepare_fmm_amr_lookup

  !> @brief
  !> Refresh the device father array for one AMR level.
  !>
  subroutine gpu_refresh_amr_father_level(sim, ilev)
    use nvtx
    use refine_device, only: update_father_array
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilev

    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks

    if (ilev <= sim%r%levelmin) return

    head_idx = sim%m%head(ilev)
    num_octs = sim%m%noct(ilev)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU refresh_amr_father", color=5)!red
       call update_father_array<<<num_blocks, num_threads>>>(grid, father, hash_key, hash_val, sim%m%hash_size, &
            & ckey_max, key_off, head_idx, num_octs)
       call nvtxEndRange()
    end if

  end subroutine gpu_refresh_amr_father_level

  !> @brief
  !> Set rho and nref arrays to zero on the device.
  !>
  !> @detail
  !> This is useful for pure particle runs.
  !>
  subroutine gpu_reset_rho(sim, ilevel)
    use nvtx
    use rho_device, only: reset_rho
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU reset_rho", color=1)!blue
       call reset_rho<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(rho, nref, head_idx, num_octs)
       call nvtxEndRange()
    end if

  end subroutine gpu_reset_rho

  !> @brief
  !> Set multipole to cell center and mass in leaf cells and zero in split cells
  !>
  !> @detail
  !> This is used to initialize the multipole upward pass.
  !>
  subroutine gpu_multipole_leaf(sim, ilevel)
    use nvtx
    use rho_device, only: multipole_leaf
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks
    real(kind=8) :: dx

    dx = real(sim%r%boxlen/2**ilevel, kind=8)

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU multipole_leaf", color=1)!blue
       call multipole_leaf<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(unew, uold, grid, &
            & head_idx, num_octs, dx)
       call nvtxEndRange()
    end if

  end subroutine gpu_multipole_leaf

  !> @brief
  !> Compute multipole in split cells.
  !>
  !> @detail
  !> Get multipole from children cells to perform the multipole upward pass.
  !>
  subroutine gpu_multipole_split(sim, ilevel)
    use nvtx
    use rho_device, only: multipole_upload, multipole_tot
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel
    !
    integer(kind=4) :: head_idx, num_octs
    integer(kind=4) :: num_blocks, num_threads

    head_idx = sim%m%head(ilevel+1)
    num_octs = sim%m%noct(ilevel+1)
    num_threads = 256
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU multipole_split", color=1)!blue
       call multipole_upload<<<num_blocks, num_threads>>>(grid, father, unew, head_idx, num_octs)
       call nvtxEndRange()
    end if

  end subroutine gpu_multipole_split

  !> @brief
  !> Deposit gas multipoles on the rho array using CIC
  !>
  !> @detail
  !> Using CIC interpolation, deposit the mass of the gas pseudo-particles on the mesh.
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_cic_multipole(sim, ilevel)
    use nvtx
    use rho_device, only: multipole_cic
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout)::sim
    integer, intent(in)::ilevel
    !
    integer(kind=4) :: head_idx, num_subgrids
    integer(kind=4) :: num_blocks, num_threads, num_octs
    real(kind=8), device :: multipole_d(ndim+1)
    real(kind=8) :: multipole_h(ndim+1)
    real(kind=8) :: dx

    dx = real(sim%r%boxlen/2**ilevel, kind=8)

    head_idx = (sim%m%head(ilevel) - 1) / nsubgridtondim + 1
    num_subgrids = sim%m%noct(ilevel) / nsubgridtondim
    num_blocks = num_subgrids
    num_threads = 64
    if (num_subgrids > 0) then
       call nvtxStartRange("GPU cic_multipole", color=1)!blue
       call multipole_cic<<<num_blocks, num_threads>>>(unew, rho, grid, nbor, &
            & head_idx, num_subgrids, dx, box_size, periodic, sim%r%ngridmax)
       call nvtxEndRange()
    endif

    if (ilevel == sim%r%levelmin) then

       multipole_d = 0d0

       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       num_threads = 256
       num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads
       if (num_octs > 0) then
          call nvtxStartRange("GPU cic_multipole", color=1)!blue
          call multipole_tot<<<num_blocks, num_threads>>>(unew, head_idx, num_octs, multipole_d)
          call nvtxEndRange()
       end if

       multipole_h = multipole_d
       sim%g%multipole%q(1:ndim+1) = sim%g%multipole%q(1:ndim+1) + multipole_h

    end if

  end subroutine gpu_cic_multipole

  subroutine gpu_cic_multipole2(sim, ilevel)
    use nvtx
    use rho_device, only: deposit_rho, multipole_tot
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs, num_blocks, num_threads
    integer :: threadsX_per_block, threadsY_per_block
    real(kind=8) :: dx, vol_loc
    real(kind=8), device :: multipole_d(ndim+1)
    real(kind=8) :: multipole_h(ndim+1)

    dx      = real(sim%r%boxlen / 2**ilevel, kind=8)
    vol_loc = dx**ndim

    head_idx           = sim%m%head(ilevel)
    num_octs           = sim%m%noct(ilevel)
    threadsX_per_block = twotondim
    threadsY_per_block = 16
    num_blocks         = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    if (num_octs > 0) then
       call nvtxStartRange("GPU cic_multipole2", color=1)!blue
       call deposit_rho<<<num_blocks, dim3(threadsX_per_block, threadsY_per_block, 1)>>>( &
            & unew, rho, grid, nbor, head_idx, num_octs, dx, vol_loc, sim%r%ngridmax)
       call nvtxEndRange()
    end if

    if (ilevel == sim%r%levelmin) then
       multipole_d = 0d0
       num_threads = 256
       num_blocks  = (num_octs * twotondim + num_threads - 1) / num_threads
       if (num_octs > 0) then
          call nvtxStartRange("GPU cic_multipole2 tot", color=1)!blue
          call multipole_tot<<<num_blocks, num_threads>>>(unew, head_idx, num_octs, multipole_d)
          call nvtxEndRange()
       end if
       multipole_h = multipole_d
       sim%g%multipole%q(1:ndim+1) = sim%g%multipole%q(1:ndim+1) + multipole_h
    end if

  end subroutine gpu_cic_multipole2

  !> @brief
  !> Save old potential in array phi_old.
  !>
  !> @detail
  !> This is useful for potential time extrapolation.
  !>
  subroutine gpu_save_phi_old(sim, ilevel)
    use nvtx
    use mg_device, only: save_phi_old
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    if (num_octs > 0) then
       call nvtxStartRange("GPU save_phi_old", color=1)!blue
       call save_phi_old<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi_old, phi, &
            & head_idx, num_octs)
       call nvtxEndRange()
    end if

  end subroutine gpu_save_phi_old

  !> @brief
  !> Reset AMR gravitational potential for the GPU FMM solve.
  !>
  subroutine gpu_reset_phi_fmm(sim, ilevel_start)
    use nvtx
    use mg_device, only: reset_phi_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel_start

    integer(kind=4) :: head_idx, num_octs
    integer :: ilevel, threadsX_per_block, threadsY_per_block, num_blocks

    threadsX_per_block = 8
    threadsY_per_block = 16

    do ilevel = max(ilevel_start, sim%r%levelmin), sim%r%nlevelmax
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
       if (num_octs > 0) then
          call nvtxStartRange("GPU reset_phi_fmm", color=1)!blue
          call reset_phi_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi, &
               & head_idx, num_octs, 0.0d0)
          call nvtxEndRange()
       end if
    end do

  end subroutine gpu_reset_phi_fmm

  !> @brief
  !> Initialize potential using interoplation from coarse level.
  !>
  !> @detail
  !> This is done for both main octs and cache octs to provide boundary conditions.
  !> When icount=2, the potential is extrapolated in time to match the time of the
  !> fine level using phi and phi_old.
  !>
  subroutine gpu_init_phi(sim, ilevel, icount)
    use nvtx
    use mg_device, only: reset_phi, make_initial_phi
    use fmm_device, only: fmm_make_initial_phi_isolated
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: icount

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks
    real(kind=8) :: tfrac, dx

    ! Compute fraction of time steps for interpolation
    if (sim%g%dtold(ilevel-1)>0.0)then
       tfrac = sim%g%dtnew(ilevel) / sim%g%dtold(ilevel-1) * (icount-1)
    else
       tfrac = 0.0
    end if
    dx = sim%r%boxlen/2**ilevel

    ! Initial guess for inner domain
    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    ! Reset phi and 3-components of force to zero
    if (num_octs > 0) then
       call nvtxStartRange("GPU init_phi", color=1)!blue
       call reset_phi<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi, f, &
            & head_idx, num_octs)
       call nvtxEndRange()
    endif

    ! Match CPU make_initial_phi: isolated base level starts from phiana.
    if (ilevel == sim%r%levelmin .and. any(.not. sim%r%periodic(1:ndim))) then
#ifdef FMM
       gravity_multipole = 0.0d0
       gravity_multipole(1:size(sim%g%multipole%q)) = sim%g%multipole%q
       if (num_octs > 0) then
          call nvtxStartRange("GPU init_phi_isolated", color=1)!blue
          call fmm_make_initial_phi_isolated<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(grid, phi, f, &
               & gravity_multipole, head_idx, num_octs, ilevel, dx, sim%m%skip(1), sim%m%skip(2), sim%m%skip(3))
          call nvtxEndRange()
       endif
#endif
    endif

    ! Interpolate phi from coarser level
    if (ilevel > sim%r%levelmin) then
       if (num_octs > 0) then
          call nvtxStartRange("GPU init_phi", color=1)!blue
          call make_initial_phi<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(grid, father, &
               & nbor, phi, phi_old, tfrac, head_idx, num_octs, sim%m%ngridmax)
          call nvtxEndRange()
       endif
    endif

    ! Boundary conditions for buffer region (ghost cells)
    ! We preserve the force in ghost cells stored in the cache
    head_idx = sim%m%ngridmax + sim%m%head_cache(ilevel)
    num_octs = sim%m%noct_cache(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    ! Interpolate phi from coarser level
    if (ilevel > sim%r%levelmin) then
       if (num_octs > 0) then
          call nvtxStartRange("GPU init_phi", color=1)!blue
          call make_initial_phi<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(grid, father, &
               & nbor, phi, phi_old, tfrac, head_idx, num_octs, sim%m%ngridmax)
          call nvtxEndRange()
       endif
    endif

  end subroutine gpu_init_phi

  !> @brief
  !> Set mask at fine level for boundary conditions.
  !>
  !> @detail
  !> mask=1 means inside the domain, mask=0 means outside.
  !> So we set 1 in inner domain octs.
  !>
  subroutine gpu_make_mask(sim, ilevel)
    use nvtx
    use mg_device, only: reset_mask_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks

    ! Set mask to 1 inside domain
    ! We preserve the force in ghost cells stored in the cache
    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU make_mask", color=1)!blue
       call reset_mask_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(f, &
            & head_idx, num_octs, 1d0)
       call nvtxEndRange()
    endif

  end subroutine gpu_make_mask

  !> @brief
  !> Modify the Poisson equation RHS to account for the boundary conditions.
  !>
  !> @detail
  !> Close to the domain boundary, modify the charge to account for the value of
  !> the potential at the boundary. The new problem is now phi=0 at the boundary.
  !>
  subroutine gpu_make_rhs(sim, ilevel, icount)
    use nvtx
    use mg_device, only: reset_rhs_kernel
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: icount

    integer(kind=4) :: head_idx, num_octs
    integer :: threadsX_per_block, threadsY_per_block, num_threads, num_blocks
    real(kind=8) :: fourpi, offset, dx, oneoverdx2, tfrac

    ! Modify the rhs to account for boundary conditions.
    ! From now on, boundary conditions are phi = 0.
    ! We preserve phi in the ghost cells stored in the cache.
    ! Note that the mask is only defined in the inner cells, not in the ghost cells.
    fourpi = 4.D0*ACOS(-1.0D0)
    if (sim%r%cosmo) fourpi = 1.5D0 * sim%g%omega_m * sim%g%aexp
    dx  = sim%r%boxlen/2**ilevel
    oneoverdx2 = 1.0d0/(dx*dx)
    offset = sim%g%rho_tot
    if(any(.not. sim%r%periodic(1:ndim)))offset = 0d0
#ifdef FMM
    if (sim%g%dtold(ilevel-1)>0.0d0) then
       tfrac = sim%g%dtnew(ilevel) / sim%g%dtold(ilevel-1) * (icount-1)
    else
       tfrac = 0.0d0
    endif
    gravity_multipole = 0.0d0
    gravity_multipole(1:size(sim%g%multipole%q)) = sim%g%multipole%q

    call nvtxStartRange("GPU upload_gradient_phi", color=5)!red
    grid = sim%m%grid
    phi = sim%m%phi
    phi_old = sim%m%phi_old
    call nvtxEndRange()
#endif

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU make_rhs", color=1)!blue
       call reset_rhs_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi, rho, f, nbor, &
            & head_idx, num_octs, sim%m%ngridmax, fourpi, offset, oneoverdx2)
       call nvtxEndRange()
    end if

  end subroutine gpu_make_rhs

  !> @brief
  !> This routine builds the MG hierarchy on top of the current level.
  !>
  !> @detail
  !> It uses children grids information to trigger the formation of parent grids
  !> starting from fine level ifine. If ifine == ilevel, then this is the finest
  !> MG level that corresponds to the AMR level.
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_build_mg(sim, ilevel, ifine)
    use nvtx
    use mg_device
    use refine_device, only: insert_hash_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: ifine
    !
    integer(kind=4) :: head_idx, head_mg, head_father, head_nbor
    integer(kind=4) :: num_octs, num_blocks, num_threads, num_blocks_2, num_threads_2
    integer(kind=4) :: new_noct, ind, cell_ind, nbor_ind
    integer(kind=4), device :: new_noct_d

    if (ifine == ilevel) then
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       head_father = 1
    else
       head_idx = sim%m_mg%head(ifine)
       num_octs = sim%m_mg%noct(ifine)
       head_father = sim%m%noct(ilevel) + sim%m_mg%head(ifine)
    endif

    if (num_octs == 0) return

    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads

    sim%m_mg%head(ifine-1) = sim%m_mg%tail(ifine) + 1
    head_mg = sim%m_mg%head(ifine-1)

    ! Init prefix sum (count new parent octs)
    call nvtxStartRange("GPU build_mg", color=2)!yellow
    if (ifine == ilevel) then
       call init_prefix_sum_mg<<<num_blocks, num_threads>>>(grid, prefix_sum, head_idx, num_octs)
    else
       call init_prefix_sum_mg<<<num_blocks, num_threads>>>(grid_mg, prefix_sum, head_idx, num_octs)
    endif
    call nvtxEndRange()

    ! Compute prefix sums
    call nvtxStartRange("GPU build_mg", color=2)!yellow
    call gpu_scan(head_idx, num_octs, new_noct_d)
    new_noct = new_noct_d
    call nvtxEndRange()

    if (new_noct > 0) then

       num_threads_2 = 128
       num_blocks_2 = (new_noct + num_threads_2 - 1) / num_threads_2

       ! Check we have enough memory
       if ((head_mg + new_noct) > sim%m_mg%ngridmax) then
          write(*,*)'No more grid memory, increase ngridmax for MG'
          write(*,*)'New multigrid octs:', new_noct
          stop
       endif

       ! Compute MG father swap table
       call nvtxStartRange("GPU build_mg", color=2)!yellow
       call compute_father_swap_table<<<num_blocks, num_threads>>>(swap_local, prefix_sum, head_idx, num_octs)
       call nvtxEndRange()

       ! Make new MG octs
       call nvtxStartRange("GPU build_mg", color=2)!yellow
       if (ifine == ilevel) then
          call make_father_octs<<<num_blocks_2, num_threads_2>>>(grid, grid_mg, phi_mg, f_mg, swap_local, &
               & head_mg, new_noct)
       else
          call make_father_octs<<<num_blocks_2, num_threads_2>>>(grid_mg, grid_mg, phi_mg, f_mg, swap_local, &
               & head_mg, new_noct)
       endif
       call nvtxEndRange()

       ! Insert new octs in hash table
       call nvtxStartRange("GPU build_mg", color=2)!yellow
       call insert_hash_kernel<<<num_blocks_2, num_threads_2>>>(grid_mg, hash_key_mg, hash_val_mg, &
            & sim%m_mg%hash_size, ckey_max, key_off, head_mg, new_noct)
       call nvtxEndRange()

    end if

    ! Compute final father array
    if (ifine == ilevel) then
       call nvtxStartRange("GPU build_mg", color=2)!yellow
       call update_father_array<<<num_blocks, num_threads>>>(father_mg, grid, grid_mg, &
            & hash_key_mg, hash_val_mg, sim%m_mg%hash_size, &
            & ckey_max, key_off, head_idx, head_father, num_octs)
       call nvtxEndRange()
    else
       call nvtxStartRange("GPU build_mg", color=2)!yellow
       call update_father_array<<<num_blocks, num_threads>>>(father_mg, grid_mg, grid_mg, &
            & hash_key_mg, hash_val_mg, sim%m_mg%hash_size, &
            & ckey_max, key_off, head_idx, head_father, num_octs)
       call nvtxEndRange()
    endif

    ! Store new first free cache oct
    head_nbor = head_mg + new_noct

    sim%m_mg%tail(ifine-1) = head_nbor - 1
    sim%m_mg%noct(ifine-1) = sim%m_mg%tail(ifine-1) - sim%m_mg%head(ifine-1) + 1

    ! Compute final nbor array
    head_idx = sim%m_mg%head(ifine-1)
    num_octs = sim%m_mg%noct(ifine-1)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads

    if (num_octs > 0) then
       call nvtxStartRange("GPU build_mg", color=2)!yellow
       call update_nbor_array_mg<<<num_blocks, num_threads>>>(nbor_mg, grid_mg, hash_key_mg, hash_val_mg, &
            & sim%m_mg%hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_octs)
       call nvtxEndRange()
    end if

  end subroutine gpu_build_mg

  !> @brief
  !> This routine cleans up the MG hierarchy.
  !>
  !> @detail
  !> It wipes out clean the hash table and the MG levels for level ilevel.
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_clean_mg(sim)
    use nvtx
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    !
    call nvtxStartRange("GPU clean_mg", color=2)!yellow
    hash_key_mg=0
    hash_val_mg=0
    call nvtxEndRange()

    sim%m_mg%head=1
    sim%m_mg%tail=0
    sim%m_mg%noct=0

  end subroutine gpu_clean_mg

  !> @brief
  !> Clean one resident standard FMM tree slot on the GPU.
  !>
  subroutine gpu_clean_fmm(sim, ilevel)
    use amr_commons, only: mesh_t
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer(kind=4), intent(in) :: ilevel
    type(mesh_t), pointer :: m_fmm

    if (.not. associated(sim%m_fmm_list)) return
    if (ilevel < lbound(sim%m_fmm_list,1) .or. ilevel > ubound(sim%m_fmm_list,1)) return

    m_fmm => sim%m_fmm_list(ilevel)
    call gpu_clean_fmm_slot(m_fmm, ilevel, .false.)

  end subroutine gpu_clean_fmm

  !> @brief
  !> Clean the resident merged FMM tree slot on the GPU.
  !>
  subroutine gpu_clean_fmm_merged(sim)
    use amr_commons, only: mesh_t
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    type(mesh_t), pointer :: m_fmm

    if (.not. associated(sim%m_fmm_merged)) return

    m_fmm => sim%m_fmm_merged
    call gpu_clean_fmm_slot(m_fmm, fmm_merged_slot, .true.)

  end subroutine gpu_clean_fmm_merged

  !> @brief
  !> Common FMM cleanup for standard and merged resident tree slots.
  !>
  subroutine gpu_clean_fmm_slot(m_fmm, slot, is_merged)
    use nvtx
    use amr_commons, only: mesh_t
    use refine_device, only: free_hash_kernel
    implicit none
    type(mesh_t), intent(inout) :: m_fmm
    integer(kind=4), intent(in) :: slot
    logical, intent(in) :: is_merged

    integer(kind=4) :: grid_offset, hash_offset, hash_capacity
    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks

    if (allocated(fmm_grid_offset)) then
       if (slot >= lbound(fmm_grid_offset,1) .and. slot <= ubound(fmm_grid_offset,1)) then
          grid_offset = fmm_grid_offset(slot)
          hash_offset = fmm_hash_offset(slot)
          hash_capacity = fmm_hash_capacity_slot(slot)
          head_idx = grid_offset + 1
          num_octs = m_fmm%noct_used
          num_threads = 128
          num_blocks = (num_octs + num_threads - 1) / num_threads
          if (num_octs > 0 .and. hash_capacity > 0 .and. allocated(grid_fmm) .and. allocated(hash_key_fmm)) then
             if (is_merged) then
                call nvtxStartRange("GPU clean_fmm_merged", color=1)!blue
             else
                call nvtxStartRange("GPU clean_fmm", color=1)!blue
             end if
             call free_hash_kernel<<<num_blocks, num_threads>>>(grid_fmm, hash_key_fmm(hash_offset+1), &
                  & hash_val_fmm(hash_offset+1), hash_capacity, ckey_max, key_off, head_idx, num_octs)
             call nvtxEndRange()
          end if
       end if
    end if

    m_fmm%head=1
    m_fmm%tail=0
    m_fmm%noct=0
    m_fmm%ifree=1
    m_fmm%noct_tot=0
    m_fmm%noct_used=0

  end subroutine gpu_clean_fmm_slot

  !> @brief
  !> This routine restrict the mask from a fine level to a coarser level.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_restrict_mask(sim, ilevel, ifine, allmasked)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: ifine
    logical, intent(out) :: allmasked
    !
    integer(kind=4) :: head_idx, head_mg, head_father
    integer(kind=4) :: threadsX_per_block, threadsY_per_block
    integer(kind=4) :: num_octs, num_blocks, num_threads
    real(kind=8), device :: mask_max
    real(kind=8) :: mask_max_host

    allmasked = .true.

    ! Initialize volume fraction to 0 at coarse level
    head_idx = sim%m_mg%head(ifine-1)
    num_octs = sim%m_mg%noct(ifine-1)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU restrict_mask", color=1)!blue
       call reset_mask_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(f_mg, &
            & head_idx, num_octs, 0d0)
       call nvtxEndRange()
    endif

    ! Restrict mask from fine level to volume fraction in coarse level
    if (ifine == ilevel) then
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       head_father = 1
    else
       head_idx = sim%m_mg%head(ifine)
       num_octs = sim%m_mg%noct(ifine)
       head_father = sim%m%noct(ilevel) + sim%m_mg%head(ifine)
    endif
    num_threads = 256
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU restrict_mask", color=1)!blue
       if (ifine == ilevel) then
          call restrict_mask<<<num_blocks, num_threads>>>(grid, father_mg, f, f_mg, &
               & head_idx, head_father, num_octs)
       else
          call restrict_mask<<<num_blocks, num_threads>>>(grid_mg, father_mg, f_mg, f_mg, &
               & head_idx, head_father, num_octs)
       endif
       call nvtxEndRange()
    endif

    ! Convert back from volume fraction (0 to 1) to mask (-1 to 1) at coarse level
    head_idx = sim%m_mg%head(ifine-1)
    num_octs = sim%m_mg%noct(ifine-1)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU restrict_mask", color=1)!blue
       mask_max = -1d0
       call volume_to_mask<<<num_blocks, num_threads>>>(f_mg, head_idx, num_octs, mask_max)
       mask_max_host = mask_max
       call nvtxEndRange()
       allmasked = (mask_max_host <= 0d0)
    endif

  end subroutine gpu_restrict_mask

  !> @brief
  !> This routine computes the residual at level ifine.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_cmp_residual(sim, ilevel, ifine)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: ifine
    !
    integer(kind=4) :: head_idx, head_mg, head_father
    integer(kind=4) :: num_octs, num_blocks, num_threads
    integer :: threadsX_per_block, threadsY_per_block
    real(kind=8) :: fourpi, offset, dx, oneoverdx2

    fourpi = 4.D0*ACOS(-1.0D0)
    if (sim%r%cosmo) fourpi = 1.5D0 * sim%g%omega_m * sim%g%aexp

    dx  = sim%r%boxlen/2**ifine
    oneoverdx2 = 1.0d0/(dx*dx)
    offset = sim%g%rho_tot
    if(any(.not. sim%r%periodic(1:ndim)))offset = 0d0

    if (ifine == ilevel) then
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
    else
       head_idx = sim%m_mg%head(ifine)
       num_octs = sim%m_mg%noct(ifine)
    endif
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU cmp_residual", color=1)!blue
       if (ifine == ilevel) then
          call cmp_residual<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi, f, nbor, &
               & head_idx, num_octs, fourpi, offset, oneoverdx2, sim%m%ngridmax)
       else
          call cmp_residual<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi_mg, f_mg, nbor_mg, &
               & head_idx, num_octs, fourpi, offset, oneoverdx2, sim%m_mg%ngridmax)
       endif
       call nvtxEndRange()
    endif

  end subroutine gpu_cmp_residual

  !> @brief
  !> This routine peforms the gauss-seidel iteration at level ifine.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_gauss_seidel(sim, ilevel, ifine, safe, redstep)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: ifine
    logical, intent(in) :: redstep
    logical, intent(in) :: safe
    !
    integer(kind=4) :: head_idx, head_mg, head_father
    integer(kind=4) :: num_octs, num_blocks, num_threads
    integer :: threadsX_per_block, threadsY_per_block
    real(kind=8) :: dx, dx2

    dx  = sim%r%boxlen/2**ifine
    dx2 = dx*dx

    if (ifine == ilevel) then
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
    else
       head_idx = sim%m_mg%head(ifine)
       num_octs = sim%m_mg%noct(ifine)
    endif
    threadsX_per_block = 4
    threadsY_per_block = 32
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU gauss_seidel", color=1)!blue
       if (ifine == ilevel) then
          call gauss_seidel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi, f, nbor, &
               & head_idx, num_octs, dx2, safe, redstep, sim%m%ngridmax)
       else
          call gauss_seidel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi_mg, f_mg, nbor_mg, &
               & head_idx, num_octs, dx2, safe, redstep, sim%m_mg%ngridmax)
       endif
       call nvtxEndRange()
    end if

  end subroutine gpu_gauss_seidel

  !> @brief
  !> This routine reset phi for multigrid to zero.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_reset_corr(sim, ilevel)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    !
    integer(kind=4) :: head_idx, num_octs, num_blocks, num_threads
    integer :: threadsX_per_block, threadsY_per_block

    head_idx = sim%m_mg%head(ilevel)
    num_octs = sim%m_mg%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU reset_corr", color=1)!blue
       call reset_phi_kernel<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi_mg, &
            & head_idx, num_octs, 0d0)
       call nvtxEndRange()
    endif

  end subroutine gpu_reset_corr

  !> @brief
  !> This routine restrict the residual from a fine level to a coarser level.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_restrict_residual(sim, ilevel, ifine)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: ifine
    !
    integer(kind=4) :: head_idx, head_mg, head_father
    integer(kind=4) :: num_octs, num_blocks, num_threads

    ! Set up the fine level
    if (ifine == ilevel) then
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       head_father = 1
    else
       head_idx = sim%m_mg%head(ifine)
       num_octs = sim%m_mg%noct(ifine)
       head_father = sim%m%noct(ilevel) + sim%m_mg%head(ifine)
    endif
    num_threads = 256
    num_blocks = (num_octs + num_threads - 1) / num_threads

    ! Restrict mask from fine to coarse grid
    if (num_octs > 0) then
       call nvtxStartRange("GPU restrict_residual", color=1)!blue
       if (ifine == ilevel) then
          call restrict_residual<<<num_blocks, num_threads>>>(grid, father_mg, f, f_mg, &
               & head_idx, head_father, num_octs)
       else
          call restrict_residual<<<num_blocks, num_threads>>>(grid_mg, father_mg, f_mg, f_mg, &
               & head_idx, head_father, num_octs)
       endif
       call nvtxEndRange()
    end if

  end subroutine gpu_restrict_residual

  !> @brief
  !> This routine interpolates the correction and corrects the solution at level ifine.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_interpolate_correct(sim, ilevel, ifine)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: ifine
    !
    integer(kind=4) :: head_idx, head_mg, head_father
    integer(kind=4) :: num_octs, num_blocks, num_threads
    integer :: threadsX_per_block, threadsY_per_block

    if (ifine == ilevel) then
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       head_father = 1
    else
       head_idx = sim%m_mg%head(ifine)
       num_octs = sim%m_mg%noct(ifine)
       head_father = sim%m%noct(ilevel) + sim%m_mg%head(ifine)
    endif
    threadsX_per_block = 8
    threadsY_per_block = nthreads_y
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block

    if (num_octs > 0) then
       call nvtxStartRange("GPU interpolate_correct", color=1)!blue
       if (ifine == ilevel) then
          call interpolate_correct<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(grid, &
               & father_mg, nbor_mg, phi, phi_mg, f, head_idx, head_father, num_octs)
       else
          call interpolate_correct<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(grid_mg, &
               & father_mg, nbor_mg, phi_mg, phi_mg, f_mg, head_idx, head_father, num_octs)
       endif
       call nvtxEndRange()
    end if

  end subroutine gpu_interpolate_correct

  !> @brief
  !> This routine computes the 2-norm of the residual.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_residual_norm2(sim, ilevel, norm)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    real(kind=8), intent(out) :: norm
    !
    integer(kind=4) :: head_idx, head_mg, head_father
    integer(kind=4) :: num_octs, num_blocks, num_threads
    real(kind=8), device :: norm_tot
    real(kind=8) :: norm_tot_host
    real(kind=8) :: dx2

    dx2  = (sim%r%boxlen/2**ilevel)**2
    norm = 0d0

    ! host to device
    norm_tot = 0d0

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads

    ! Compute residual norm
    if (num_octs > 0) then
       call nvtxStartRange("GPU residual_norm2", color=1)!blue
       call residual_norm<<<num_blocks, num_threads>>>(f, head_idx, num_octs, norm_tot)
       norm_tot_host = norm_tot ! device to host
       call nvtxEndRange()
       norm = dx2 * norm_tot_host
    end if

  end subroutine gpu_residual_norm2

  !> @brief
  !> This routine computes the gradient of the potential ans stores it in the force.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_gradient_phi(sim, ilevel, icount)
    use nvtx
    use mg_device
    use fmm_device, only: fmm_gradient_phi
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: icount
    !
    integer(kind=4) :: head_idx
    integer(kind=4) :: num_octs, num_blocks
    integer :: threadsX_per_block, threadsY_per_block
    real(kind=8) :: dx, tfrac

    dx  = sim%r%boxlen/2**ilevel
#ifdef FMM
    if (sim%g%dtold(ilevel-1)>0.0d0) then
       tfrac = sim%g%dtnew(ilevel) / sim%g%dtold(ilevel-1) * (icount-1)
    else
       tfrac = 0.0d0
    endif
    gravity_multipole = 0.0d0
    gravity_multipole(1:size(sim%g%multipole%q)) = sim%g%multipole%q

#endif

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    threadsX_per_block = 8
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU gradient_phi", color=1)!blue
#ifdef FMM
       if (any(.not. sim%r%periodic(1:ndim))) then
          call fmm_gradient_phi<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(grid, phi, f, nbor, &
               & box_ckey_min, box_ckey_max, periodic, gravity_multipole, head_idx, num_octs, ilevel, sim%m%ngridmax, &
               & dx, sim%m%skip(1), sim%m%skip(2), sim%m%skip(3))
       else
          call gradient_phi<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi, f, nbor, &
               & head_idx, num_octs, dx)
       end if
#else
       call gradient_phi<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>(phi, f, nbor, &
            & head_idx, num_octs, dx)
#endif
       call nvtxEndRange()
    end if

  end subroutine gpu_gradient_phi

  !> @brief
  !> This routine computes the gravitational potential energy.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_epot(sim, ilevel, epot)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    real(kind=8), intent(out) :: epot
    !
    integer(kind=4) :: head_idx
    integer(kind=4) :: num_octs, num_blocks, num_threads
    real(kind=8), device :: epot_tot
    real(kind=8) :: epot_tot_host
    real(kind=8) :: dx, fourpi, fact

    dx = sim%r%boxlen/2**ilevel
    fourpi = 4.0D0 * ACOS(-1.0D0)
    if (sim%r%cosmo) fourpi = 1.5D0 * sim%g%omega_m * sim%g%aexp
    fact = -dx**ndim / fourpi / 2.0D0
    epot = 0d0

    ! host to device
    epot_tot = 0d0

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads

    ! Compute residual norm
    if (num_octs > 0) then
       call nvtxStartRange("GPU epot", color=1)!blue
       call cmp_epot<<<num_blocks, num_threads>>>(grid, f, head_idx, num_octs, epot_tot)
       epot_tot_host = epot_tot ! device to host
       call nvtxEndRange()
       epot = fact * epot_tot_host
    end if

  end subroutine gpu_epot

  !> @brief
  !> This routine computes the maximum total density.
  !>
  !> @detail
  !>
  !> @param[in] sim : The simulation object
  !> @param[in] ilevel : The refinement level to update
  !>
  subroutine gpu_rhomax(sim, ilevel, rhomax)
    use nvtx
    use mg_device
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    real(kind=8), intent(out) :: rhomax
    !
    integer(kind=4) :: head_idx
    integer(kind=4) :: num_octs, num_blocks, num_threads
    real(kind=8), device :: rhomax_tot
    real(kind=8) :: rhomax_tot_host

    rhomax = 0d0

    ! host to device
    rhomax_tot = 0d0

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 256
    num_blocks = (num_octs * twotondim + num_threads - 1 ) / num_threads

    ! Compute residual norm
    if (num_octs > 0) then
       call nvtxStartRange("GPU rhomax", color=1)!blue
       call cmp_rhomax<<<num_blocks, num_threads>>>(rho, head_idx, num_octs, rhomax_tot)
       rhomax_tot_host = rhomax_tot ! device to host
       call nvtxEndRange()
       rhomax = rhomax_tot_host
    end if

  end subroutine gpu_rhomax

  !> @brief
  !> Ensure the device FMM pool has one slot per refinement tree plus one merged slot.
  !>
  subroutine gpu_ensure_fmm_capacity(sim)
    use amr_commons, only: mesh_t
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(in) :: sim

    type(mesh_t), pointer :: m_fmm
    integer(kind=4) :: ilev, levelmin, levelmax, merged_slot
    integer(kind=4) :: grid_capacity, hash_capacity, total_grid_capacity, total_hash_capacity
    integer(kind=4) :: amr_grid_capacity, total_father_capacity, source_parent_capacity

    if (.not. associated(sim%m_fmm_list)) return

    levelmin = sim%r%levelmin
    levelmax = sim%r%nlevelmax
    merged_slot = levelmax + 1

    if (allocated(fmm_grid_offset)) then
       if (lbound(fmm_grid_offset,1) /= levelmin .or. ubound(fmm_grid_offset,1) /= merged_slot) then
          deallocate(fmm_grid_offset, fmm_grid_capacity_slot, fmm_hash_offset, fmm_hash_capacity_slot)
       end if
    end if
    if (.not. allocated(fmm_grid_offset)) then
       allocate(fmm_grid_offset(levelmin:merged_slot))
       allocate(fmm_grid_capacity_slot(levelmin:merged_slot))
       allocate(fmm_hash_offset(levelmin:merged_slot))
       allocate(fmm_hash_capacity_slot(levelmin:merged_slot))
    end if

    fmm_grid_offset = 0
    fmm_grid_capacity_slot = 0
    fmm_hash_offset = 0
    fmm_hash_capacity_slot = 0
    total_grid_capacity = 0
    total_hash_capacity = 0
    amr_grid_capacity = sim%m%ngridmax + sim%m%ncachemax

    do ilev = levelmin, levelmax
       m_fmm => sim%m_fmm_list(ilev)
       grid_capacity = m_fmm%ngridmax + m_fmm%ncachemax
       hash_capacity = 2 * grid_capacity
       fmm_grid_offset(ilev) = total_grid_capacity
       fmm_grid_capacity_slot(ilev) = grid_capacity
       fmm_hash_offset(ilev) = total_hash_capacity
       fmm_hash_capacity_slot(ilev) = hash_capacity
       total_grid_capacity = total_grid_capacity + grid_capacity
       total_hash_capacity = total_hash_capacity + hash_capacity
    end do

    if (associated(sim%m_fmm_merged)) then
       m_fmm => sim%m_fmm_merged
       grid_capacity = m_fmm%ngridmax + m_fmm%ncachemax
       hash_capacity = 2 * grid_capacity
       fmm_grid_offset(merged_slot) = total_grid_capacity
       fmm_grid_capacity_slot(merged_slot) = grid_capacity
       fmm_hash_offset(merged_slot) = total_hash_capacity
       fmm_hash_capacity_slot(merged_slot) = hash_capacity
       total_grid_capacity = total_grid_capacity + grid_capacity
       total_hash_capacity = total_hash_capacity + hash_capacity
    end if

    total_father_capacity = amr_grid_capacity + total_grid_capacity
    source_parent_capacity = max(amr_grid_capacity, total_grid_capacity)

    if (total_grid_capacity > fmm_grid_capacity) then
       if (allocated(grid_fmm)) deallocate(grid_fmm)
       if (allocated(multipole_fmm)) deallocate(multipole_fmm)
       if (allocated(taylor_fmm)) deallocate(taylor_fmm)
       if (allocated(nbor_fmm)) deallocate(nbor_fmm)
       allocate(grid_fmm(1:total_grid_capacity))
       allocate(multipole_fmm(1:twotondim,1:multipole_size,1:total_grid_capacity))
       allocate(taylor_fmm(1:twotondim,1:taylor_size,1:total_grid_capacity))
       allocate(nbor_fmm(1:subgridsize,1:total_grid_capacity))
       multipole_fmm = 0.0_dp
       taylor_fmm = 0.0_dp
       nbor_fmm = 0
       fmm_grid_capacity = total_grid_capacity
    end if

    if (total_father_capacity > fmm_father_capacity) then
       if (allocated(father_fmm)) deallocate(father_fmm)
       allocate(father_fmm(1:total_father_capacity))
       father_fmm = 0
       fmm_father_capacity = total_father_capacity
    end if
    fmm_father_amr_capacity = amr_grid_capacity
    fmm_father_grid_offset = amr_grid_capacity

    if (source_parent_capacity > fmm_source_parent_capacity) then
       if (allocated(source_parent_fmm)) deallocate(source_parent_fmm)
       if (allocated(source_grid_fmm)) deallocate(source_grid_fmm)
       allocate(source_parent_fmm(1:source_parent_capacity))
       allocate(source_grid_fmm(1:source_parent_capacity))
       source_parent_fmm = 0
       source_grid_fmm = 0
       fmm_source_parent_capacity = source_parent_capacity
    end if

    if (total_hash_capacity > fmm_hash_capacity) then
       if (allocated(hash_key_fmm)) deallocate(hash_key_fmm)
       if (allocated(hash_val_fmm)) deallocate(hash_val_fmm)
       allocate(hash_key_fmm(1:total_hash_capacity))
       allocate(hash_val_fmm(1:total_hash_capacity))
       hash_key_fmm = 0
       hash_val_fmm = 0
       fmm_hash_capacity = total_hash_capacity
    end if

    fmm_slot_levelmin = levelmin
    fmm_slot_levelmax = levelmax
    fmm_merged_slot = merged_slot

  end subroutine gpu_ensure_fmm_capacity

  !> @brief
  !> Build father/nbor sidecar arrays for one FMM tree slot.
  !>
  subroutine gpu_build_fmm_topology(m_fmm, slot, is_merged)
    use nvtx
    use amr_commons, only: mesh_t
    use refine_device, only: update_father_array, update_nbor_array
    implicit none
    type(mesh_t), intent(in) :: m_fmm
    integer(kind=4), intent(in) :: slot
    logical, intent(in) :: is_merged

    integer(kind=4) :: flev, head_idx, num_octs, num_subgrids, num_threads, num_blocks, ind
    integer(kind=4) :: grid_offset, grid_capacity, hash_offset, hash_capacity

    grid_offset = fmm_grid_offset(slot)
    grid_capacity = fmm_grid_capacity_slot(slot)
    hash_offset = fmm_hash_offset(slot)
    hash_capacity = fmm_hash_capacity_slot(slot)
    if (grid_capacity <= 0 .or. hash_capacity <= 0) return

    num_threads = 128

    do flev = 1, size(m_fmm%head)
       head_idx = grid_offset + m_fmm%head(flev)
       num_octs = m_fmm%noct(flev)
       if (num_octs <= 0) cycle

       num_blocks = (num_octs + num_threads - 1) / num_threads
       if (flev > 1) then
          if (is_merged) then
             call nvtxStartRange("GPU build_fmm_merged_father", color=2)!yellow
          else
             call nvtxStartRange("GPU build_fmm_father", color=2)!yellow
          end if
          call update_father_array<<<num_blocks, num_threads>>>(grid_fmm, father_fmm(fmm_father_grid_offset+1), &
               & hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), hash_capacity, &
               & ckey_max, key_off, head_idx, num_octs)
          call nvtxEndRange()
       end if

       num_subgrids = num_octs / nsubgridtondim
       num_blocks = (num_subgrids + num_threads - 1) / num_threads
       if (num_subgrids > 0) then
          if (is_merged) then
             call nvtxStartRange("GPU build_fmm_merged_nbor", color=2)!yellow
          else
             call nvtxStartRange("GPU build_fmm_nbor", color=2)!yellow
          end if
          do ind = 1, subgridsize
             call update_nbor_array<<<num_blocks, num_threads>>>(nbor_fmm, grid_fmm, &
                  & hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), hash_capacity, &
                  & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_subgrids, ind)
          end do
          call nvtxEndRange()
       end if
    end do

  end subroutine gpu_build_fmm_topology

  !> @brief
  !> Build one coarser level of a standard FMM tree directly on the GPU.
  !>
  subroutine gpu_build_fmm_level(sim, ilevel, ifine)
    use nvtx
    use amr_commons, only: mesh_t
    use cub_inclusive_scan_mod
    use fmm_device, only: fmm_init_prefix_sum_parent, fmm_compute_swap_table, fmm_make_parent_octs
    use refine_device, only: insert_hash_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel, ifine

    type(mesh_t), pointer :: m_fmm
    integer(kind=4) :: slot, grid_offset, grid_capacity, hash_offset, hash_capacity
    integer(kind=4) :: hash_start, hash_stop, source_head, num_child
    integer(kind=4) :: local_parent_head, parent_head_global, new_noct
    integer(kind=4) :: num_threads, num_blocks, num_blocks_2, icoarse
    integer(kind=4), device :: new_noct_d
    logical :: check_refinement

    if (.not. associated(sim%m_fmm_list)) return
    call gpu_ensure_fmm_capacity(sim)

    slot = int(ilevel, kind=4)
    m_fmm => sim%m_fmm_list(ilevel)
    grid_offset = fmm_grid_offset(slot)
    grid_capacity = fmm_grid_capacity_slot(slot)
    hash_offset = fmm_hash_offset(slot)
    hash_capacity = fmm_hash_capacity_slot(slot)
    hash_start = hash_offset + 1
    hash_stop = hash_offset + hash_capacity
    icoarse = ifine - 1

    if (ifine == ilevel) then
       hash_key_fmm(hash_start:hash_stop) = 0
       hash_val_fmm(hash_start:hash_stop) = 0
       multipole_fmm(:,:,grid_offset+1:grid_offset+grid_capacity) = 0.0_dp
       taylor_fmm(:,:,grid_offset+1:grid_offset+grid_capacity) = 0.0_dp
    end if

    local_parent_head = m_fmm%noct_used + 1
    parent_head_global = grid_offset + local_parent_head
    m_fmm%head(icoarse) = local_parent_head

    if (ifine == ilevel) then
       source_head = sim%m%head(ifine)
       num_child = sim%m%noct(ifine)
       check_refinement = .true.
    else
       source_head = grid_offset + m_fmm%head(ifine)
       num_child = m_fmm%noct(ifine)
       check_refinement = .false.
    end if

    num_threads = 128
    num_blocks = (num_child + num_threads - 1) / num_threads
    if (num_child > 0) then
       call nvtxStartRange("GPU build_fmm", color=2)!yellow
       if (ifine == ilevel) then
          call fmm_init_prefix_sum_parent<<<num_blocks, num_threads>>>(grid, prefix_sum, box_ckey_min, &
               & box_ckey_max, source_head, num_child, icoarse, check_refinement)
       else
          call fmm_init_prefix_sum_parent<<<num_blocks, num_threads>>>(grid_fmm, prefix_sum, box_ckey_min, &
               & box_ckey_max, source_head, num_child, icoarse, check_refinement)
       end if
       call nvtxEndRange()

       call nvtxStartRange("GPU build_fmm_scan_make", color=2)!yellow
#if defined(CUB_SCAN)
       call cub_inclusive_sum(c_loc(prefix_sum), 1, num_child)
       call get_total_sum<<<1,1>>>(prefix_sum, 1, num_child, new_noct_d)
#else
       call gpu_scan(1, num_child, new_noct_d)
#endif
       call nvtxEndRange()
    else
       new_noct_d = 0
    end if

    new_noct = new_noct_d
    if (parent_head_global + new_noct > grid_offset + grid_capacity + 1) then
       write(*,*)'No more grid memory, increase ngridmax for FMM'
       write(*,*)'New FMM octs:', new_noct
       stop
    end if

    if (new_noct > 0) then
       num_blocks_2 = (new_noct + num_threads - 1) / num_threads
       call nvtxStartRange("GPU build_fmm_make", color=2)!yellow
       call fmm_compute_swap_table<<<num_blocks, num_threads>>>(swap_local, prefix_sum, source_head, num_child)
       if (ifine == ilevel) then
          call fmm_make_parent_octs<<<num_blocks_2, num_threads>>>(grid, grid_fmm, multipole_fmm, taylor_fmm, &
               & swap_local, parent_head_global, new_noct)
       else
          call fmm_make_parent_octs<<<num_blocks_2, num_threads>>>(grid_fmm, grid_fmm, multipole_fmm, taylor_fmm, &
               & swap_local, parent_head_global, new_noct)
       end if
       call insert_hash_kernel<<<num_blocks_2, num_threads>>>(grid_fmm, hash_key_fmm(hash_start), &
            & hash_val_fmm(hash_start), hash_capacity, ckey_max, key_off, parent_head_global, new_noct)
       call nvtxEndRange()
    end if

    m_fmm%tail(icoarse) = local_parent_head + new_noct - 1
    m_fmm%noct(icoarse) = new_noct
    m_fmm%noct_used = m_fmm%tail(icoarse)
    m_fmm%ifree = m_fmm%noct_used + 1

    if (ifine == sim%r%bound_levelmin + 1) then
       call gpu_build_fmm_topology(m_fmm, slot, .false.)
    end if
    ! Keep standard FMM trees device-resident.  The GPU kernels below only
    ! need CPU scalar metadata (head/tail/noct), not a full host mirror.

  end subroutine gpu_build_fmm_level

  !> @brief
  !> Build the merged FMM tree directly on the GPU from standard FMM tree slots.
  !>
  subroutine gpu_build_fmm_merged(sim, active_levelmin)
    use nvtx
    use amr_commons, only: mesh_t
    use fmm_device, only: fmm_init_prefix_sum_copy_unique, fmm_compute_swap_table, fmm_copy_unique_octs
    use refine_device, only: insert_hash_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: active_levelmin

    type(mesh_t), pointer :: m_merged
    integer(kind=4) :: slot, grid_offset, grid_capacity, hash_offset, hash_capacity
    integer(kind=4) :: hash_start, hash_stop, flev, jlev, source_head, num_source
    integer(kind=4) :: first_ifree_global, next_ifree_global, new_noct, new_noct_chunk
    integer(kind=4) :: num_threads, num_blocks, num_blocks_2
    integer(kind=4), device :: new_noct_d

    if (.not. associated(sim%m_fmm_merged)) return
    call gpu_ensure_fmm_capacity(sim)

    slot = fmm_merged_slot
    m_merged => sim%m_fmm_merged
    grid_offset = fmm_grid_offset(slot)
    grid_capacity = fmm_grid_capacity_slot(slot)
    hash_offset = fmm_hash_offset(slot)
    hash_capacity = fmm_hash_capacity_slot(slot)
    hash_start = hash_offset + 1
    hash_stop = hash_offset + hash_capacity

    hash_key_fmm(hash_start:hash_stop) = 0
    hash_val_fmm(hash_start:hash_stop) = 0
    multipole_fmm(:,:,grid_offset+1:grid_offset+grid_capacity) = 0.0_dp
    taylor_fmm(:,:,grid_offset+1:grid_offset+grid_capacity) = 0.0_dp

    m_merged%head = 1
    m_merged%tail = 0
    m_merged%noct = 0
    m_merged%ifree = 1
    m_merged%noct_tot = 0
    m_merged%noct_used = 0

    next_ifree_global = grid_offset + 1
    num_threads = 128

    do flev = sim%r%bound_levelmin, sim%r%nlevelmax
       first_ifree_global = next_ifree_global
       do jlev = max(active_levelmin, flev+1), sim%r%nlevelmax
          if (sim%m_fmm_list(jlev)%tail(flev) < sim%m_fmm_list(jlev)%head(flev)) cycle
          source_head = fmm_grid_offset(jlev) + sim%m_fmm_list(jlev)%head(flev)
          num_source = sim%m_fmm_list(jlev)%noct(flev)
          num_blocks = (num_source + num_threads - 1) / num_threads
          if (num_source > 0) then
             call nvtxStartRange("GPU build_fmm_merged", color=2)!yellow
             call fmm_init_prefix_sum_copy_unique<<<num_blocks, num_threads>>>(grid_fmm, prefix_sum, &
                  & hash_key_fmm(hash_start), hash_val_fmm(hash_start), hash_capacity, ckey_max, key_off, &
                  & box_ckey_min, box_ckey_max, source_head, num_source, flev)
             call nvtxEndRange()
             call gpu_scan(1, num_source, new_noct_d)
             new_noct_chunk = new_noct_d
             if (next_ifree_global + new_noct_chunk > grid_offset + grid_capacity + 1) then
                write(*,*)'No more grid memory, increase ngridmax for merged FMM tree'
                write(*,*)'New merged FMM octs:', next_ifree_global + new_noct_chunk - first_ifree_global
                stop
             end if
             if (new_noct_chunk > 0) then
                num_blocks_2 = (new_noct_chunk + num_threads - 1) / num_threads
                call nvtxStartRange("GPU build_fmm_merged", color=2)!yellow
                call fmm_compute_swap_table<<<num_blocks, num_threads>>>(swap_local, prefix_sum, source_head, num_source)
                call fmm_copy_unique_octs<<<num_blocks_2, num_threads>>>(grid_fmm, grid_fmm, multipole_fmm, &
                     & taylor_fmm, swap_local, next_ifree_global, new_noct_chunk)
                call insert_hash_kernel<<<num_blocks_2, num_threads>>>(grid_fmm, hash_key_fmm(hash_start), &
                     & hash_val_fmm(hash_start), hash_capacity, ckey_max, key_off, next_ifree_global, new_noct_chunk)
                call nvtxEndRange()
                next_ifree_global = next_ifree_global + new_noct_chunk
             end if
          end if
       end do

       new_noct = next_ifree_global - first_ifree_global
       if (new_noct > 0) then
          m_merged%head(flev) = first_ifree_global - grid_offset
          m_merged%tail(flev) = m_merged%head(flev) + new_noct - 1
          m_merged%noct(flev) = new_noct
       else
          m_merged%head(flev) = 1
          m_merged%tail(flev) = 0
          m_merged%noct(flev) = 0
       end if
    end do

    m_merged%ifree = next_ifree_global - grid_offset
    m_merged%noct_used = m_merged%ifree - 1

    call gpu_build_fmm_topology(m_merged, slot, .true.)

  end subroutine gpu_build_fmm_merged

  !> @brief
  !> Accumulate standard FMM multipoles into the resident merged FMM tree.
  !>
  subroutine gpu_fmm_merge_multipoles(sim, active_levelmin)
    use nvtx
    use fmm_device, only: fmm_merge_multipoles_to_unique
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: active_levelmin

#ifdef FMM
    integer(kind=4) :: slot, hash_offset, hash_capacity, hash_start
    integer(kind=4) :: ilevel, flev, source_head, num_source
    integer(kind=4) :: num_threads, num_blocks

    if (.not. associated(sim%m_fmm_merged)) return
    call gpu_ensure_fmm_capacity(sim)

    slot = fmm_merged_slot
    hash_offset = fmm_hash_offset(slot)
    hash_capacity = fmm_hash_capacity_slot(slot)
    hash_start = hash_offset + 1
    num_threads = 128

    call nvtxStartRange("GPU fmm_merge_multipoles", color=1)!blue
    do ilevel = active_levelmin, sim%r%nlevelmax
       do flev = sim%r%bound_levelmin, ilevel - 1
          if (sim%m_fmm_list(ilevel)%tail(flev) < sim%m_fmm_list(ilevel)%head(flev)) cycle
          source_head = fmm_grid_offset(ilevel) + sim%m_fmm_list(ilevel)%head(flev)
          num_source = sim%m_fmm_list(ilevel)%noct(flev)
          if (num_source <= 0) cycle

          num_blocks = (num_source + num_threads - 1) / num_threads
          call fmm_merge_multipoles_to_unique<<<num_blocks, num_threads>>>(grid_fmm, multipole_fmm, &
               & hash_key_fmm(hash_start), hash_val_fmm(hash_start), hash_capacity, ckey_max, key_off, &
               & source_head, num_source, flev)
       end do
    end do
    call nvtxEndRange()
#endif

  end subroutine gpu_fmm_merge_multipoles

  !> @brief
  !> GPU entry point matching CPU build_fmm/build_fmm_merged.
  !>
  subroutine gpu_build_fmm(sim, ilevel, ifine, build_merged)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel, ifine
    logical, intent(in) :: build_merged

    if (build_merged) then
       call gpu_build_fmm_merged(sim, ilevel)
    else
       call gpu_build_fmm_level(sim, ilevel, ifine)
    end if

  end subroutine gpu_build_fmm

  !> @brief
  !> Select a level FMM tree slot already resident on the device.
  !>
  subroutine gpu_select_fmm_tree(sim, ilevel, slot)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer(kind=4), intent(out) :: slot

    slot = 0
#ifdef FMM
    if (.not. associated(sim%m_fmm_list)) return
    call gpu_ensure_fmm_capacity(sim)
    slot = int(ilevel, kind=4)
#else
    slot = 0
#endif

  end subroutine gpu_select_fmm_tree

  !> @brief
  !> Select the tree slot used as the read-side operand for an FMM interaction.
  !>
  subroutine gpu_select_fmm_interaction_tree(sim, jlev, use_merged, slot)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: jlev
    logical, intent(in) :: use_merged
    integer(kind=4), intent(out) :: slot

    slot = 0
#ifdef FMM
    call gpu_ensure_fmm_capacity(sim)
    if (use_merged .and. associated(sim%m_fmm_merged)) then
       slot = fmm_merged_slot
    else
       slot = int(jlev, kind=4)
    end if
#else
    slot = 0
#endif

  end subroutine gpu_select_fmm_interaction_tree

  !> @brief
  !> Build the compact AMR-source section of father_fmm for one FMM tree slot.
  !>
  subroutine gpu_refresh_amr_fmm_father_level(sim, ilevel, tree_slot)
    use nvtx
    use fmm_device, only: update_fmm_father_array
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer(kind=4), intent(in) :: tree_slot

    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks
    integer(kind=4) :: hash_offset, hash_capacity

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    if (num_octs <= 0) return

    hash_offset = fmm_hash_offset(tree_slot)
    hash_capacity = fmm_hash_capacity_slot(tree_slot)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    call nvtxStartRange("GPU refresh_amr_fmm_father", color=5)!red
    call update_fmm_father_array<<<num_blocks, num_threads>>>(father_fmm, grid, &
         & hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), hash_capacity, ckey_max, key_off, &
         & head_idx, 1, num_octs, .true.)
    call nvtxEndRange()

  end subroutine gpu_refresh_amr_fmm_father_level

  !> @brief
  !> Build compact target-FMM to source-FMM parent links for one interaction level.
  !>
  subroutine gpu_refresh_fmm_source_parent_level(sim, ilevel, flev, source_slot)
    use nvtx
    use fmm_device, only: update_fmm_father_array
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel, flev
    integer(kind=4), intent(in) :: source_slot

    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks
    integer(kind=4) :: target_grid_offset, hash_offset, hash_capacity

    target_grid_offset = fmm_grid_offset(ilevel)
    head_idx = target_grid_offset + sim%m_fmm_list(ilevel)%head(flev)
    num_octs = sim%m_fmm_list(ilevel)%noct(flev)
    if (num_octs <= 0) return

    hash_offset = fmm_hash_offset(source_slot)
    hash_capacity = fmm_hash_capacity_slot(source_slot)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    call nvtxStartRange("GPU refresh_fmm_source_parent", color=5)!red
    call update_fmm_father_array<<<num_blocks, num_threads>>>(source_parent_fmm, grid_fmm, &
         & hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), hash_capacity, ckey_max, key_off, &
         & head_idx, 1, num_octs, .false.)
    call nvtxEndRange()

  end subroutine gpu_refresh_fmm_source_parent_level

  !> @brief
  !> Build compact AMR-target to same-level source-FMM grid links for direct Taylor.
  !>
  subroutine gpu_refresh_amr_fmm_grid_level(sim, ilevel, tree_slot)
    use nvtx
    use fmm_device, only: update_fmm_grid_array
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer(kind=4), intent(in) :: tree_slot

    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks
    integer(kind=4) :: hash_offset, hash_capacity

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    if (num_octs <= 0) return

    hash_offset = fmm_hash_offset(tree_slot)
    hash_capacity = fmm_hash_capacity_slot(tree_slot)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    call nvtxStartRange("GPU refresh_amr_fmm_grid", color=5)!red
    call update_fmm_grid_array<<<num_blocks, num_threads>>>(source_grid_fmm, grid, &
         & hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), hash_capacity, ckey_max, key_off, &
         & head_idx, 1, num_octs)
    call nvtxEndRange()

  end subroutine gpu_refresh_amr_fmm_grid_level

  !> @brief
  !> Copy device FMM multipoles back to the CPU level tree.
  !>
  subroutine gpu_download_fmm_tree(sim, ilevel)
    use nvtx
    use amr_commons, only: mesh_t
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

#ifdef FMM
    type(mesh_t), pointer :: m_fmm
    integer(kind=4) :: grid_offset, grid_capacity, grid_start, grid_stop

    if (.not. associated(sim%m_fmm_list)) return
    m_fmm => sim%m_fmm_list(ilevel)

    if (.not. allocated(multipole_fmm)) return
    grid_offset = fmm_grid_offset(ilevel)
    grid_capacity = fmm_grid_capacity_slot(ilevel)
    if (grid_capacity <= 0) return
    grid_start = grid_offset + 1
    grid_stop = grid_offset + grid_capacity

    call nvtxStartRange("GPU download_fmm_tree", color=5)!red
    m_fmm%multipole = multipole_fmm(:,:,grid_start:grid_stop)
    call nvtxEndRange()
#endif

  end subroutine gpu_download_fmm_tree

  !> @brief
  !> Reduce the root FMM multipoles to the host global-multipole bookkeeping vector.
  !>
  subroutine gpu_reduce_fmm_global_multipole_source(sim, ilevel)
    use nvtx
    use fmm_device, only: fmm_accumulate_global_multipole
    use amr_commons, only: mesh_t
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

#ifdef FMM
    type(mesh_t), pointer :: m_fmm
    integer(kind=4) :: tree_slot, grid_offset, flev, num_octs, source_head
    integer(kind=4) :: num_threads, num_blocks
    real(kind=dp) :: multipole_h(1:multipole_size)

    if (.not. associated(sim%m_fmm_list)) return
    if (.not. allocated(multipole_fmm)) return

    m_fmm => sim%m_fmm_list(ilevel)
    flev = sim%r%bound_levelmin
    if (m_fmm%tail(flev) < m_fmm%head(flev)) return

    call gpu_select_fmm_tree(sim, ilevel, tree_slot)
    grid_offset = fmm_grid_offset(tree_slot)
    source_head = grid_offset + m_fmm%head(flev)
    num_octs = m_fmm%noct(flev)
    if (num_octs <= 0) return

    fmm_global_multipole = 0.0_dp
    num_threads = 128
    num_blocks = (num_octs * twotondim + num_threads - 1) / num_threads
    call nvtxStartRange("GPU reduce_fmm_global_multipole", color=1)!blue
    call fmm_accumulate_global_multipole<<<num_blocks, num_threads>>>(multipole_fmm, fmm_global_multipole, &
         & source_head, num_octs)
    multipole_h = fmm_global_multipole
    call nvtxEndRange()

    sim%g%multipole_fmm_level(ilevel)%q(1:multipole_size) = multipole_h(1:multipole_size)
#endif

  end subroutine gpu_reduce_fmm_global_multipole_source

  !> @brief
  !> Reset multipoles and Taylor coefficients in one level of a staged FMM tree.
  !>
  subroutine gpu_reset_fmm_multipoles_taylor(sim, ilevel, flev)
    use nvtx
    use fmm_device, only: fmm_reset_multipole_taylor
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel, flev

    integer(kind=4) :: head_idx, num_octs, grid_offset, tree_slot
    integer :: threadsX_per_block, threadsY_per_block, num_blocks

#ifdef FMM
    call gpu_select_fmm_tree(sim, ilevel, tree_slot)

    grid_offset = fmm_grid_offset(tree_slot)
    head_idx = grid_offset + sim%m_fmm_list(ilevel)%head(flev)
    num_octs = sim%m_fmm_list(ilevel)%noct(flev)
    threadsX_per_block = twotondim
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU reset_fmm_multipoles_taylor", color=1)!blue
       call fmm_reset_multipole_taylor<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>( &
            & multipole_fmm, taylor_fmm, head_idx, num_octs)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_reset_fmm_multipoles_taylor

  !> @brief
  !> Local GPU version of fmm_multipole_amr2fmm using a device FMM tree.
  !>
  subroutine gpu_fmm_multipole_amr2fmm(sim, ilevel)
    use nvtx
    use fmm_device, only: fmm_multipole_amr2fmm
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks
    integer(kind=4) :: tree_slot
    real(kind=dp) :: dx_loc, vol_loc, skip1, skip2, skip3

#ifdef FMM
    call gpu_select_fmm_tree(sim, ilevel, tree_slot)

    call gpu_refresh_amr_fmm_father_level(sim, ilevel, tree_slot)

    dx_loc = real(sim%r%boxlen / 2.0D0**ilevel, kind=dp)
    vol_loc = dx_loc**ndim
    skip1 = real(sim%m%skip(1), kind=dp)
    skip2 = 0.0_dp
    skip3 = 0.0_dp
#if NDIM>1
    skip2 = real(sim%m%skip(2), kind=dp)
#endif
#if NDIM>2
    skip3 = real(sim%m%skip(3), kind=dp)
#endif

    head_idx = sim%m%head(ilevel)
    num_octs = sim%m%noct(ilevel)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU fmm_multipole_amr2fmm", color=1)!blue
       call fmm_multipole_amr2fmm<<<num_blocks, num_threads>>>(grid, rho, multipole_fmm, father_fmm, &
            & head_idx, 1, num_octs, dx_loc, vol_loc, skip1, skip2, skip3)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_fmm_multipole_amr2fmm

  !> @brief
  !> Accumulate child FMM cell multipoles into parent FMM cells.
  !>
  subroutine gpu_fmm_multipole_fmm2fmm(sim, ilevel, flev)
    use nvtx
    use fmm_device, only: fmm_multipole_fmm2fmm
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel, flev

    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks
    integer(kind=4) :: tree_slot, grid_offset

#ifdef FMM
    call gpu_select_fmm_tree(sim, ilevel, tree_slot)
    grid_offset = fmm_grid_offset(tree_slot)

    head_idx = grid_offset + sim%m_fmm_list(ilevel)%head(flev+1)
    num_octs = sim%m_fmm_list(ilevel)%noct(flev+1)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU fmm_multipole_fmm2fmm", color=1)!blue
       call fmm_multipole_fmm2fmm<<<num_blocks, num_threads>>>(grid_fmm, multipole_fmm, &
            & father_fmm(fmm_father_grid_offset+1), head_idx, num_octs)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_fmm_multipole_fmm2fmm

  !> @brief
  !> Shift FMM multipoles from absolute coordinates into each FMM cell center.
  !>
  subroutine gpu_fmm_multipole_shift_downward(sim, ilevel, flev)
    use nvtx
    use fmm_device, only: fmm_multipole_shift_downward
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel, flev

    integer(kind=4) :: head_idx, num_octs, tree_slot, grid_offset
    integer :: threadsX_per_block, threadsY_per_block, num_blocks
    real(kind=dp) :: dx_loc, skip1, skip2, skip3

#ifdef FMM
    call gpu_select_fmm_tree(sim, ilevel, tree_slot)
    grid_offset = fmm_grid_offset(tree_slot)

    dx_loc = real(sim%r%boxlen / 2.0D0**flev, kind=dp)
    skip1 = real(sim%m%skip(1), kind=dp)
    skip2 = 0.0_dp
    skip3 = 0.0_dp
#if NDIM>1
    skip2 = real(sim%m%skip(2), kind=dp)
#endif
#if NDIM>2
    skip3 = real(sim%m%skip(3), kind=dp)
#endif

    head_idx = grid_offset + sim%m_fmm_list(ilevel)%head(flev)
    num_octs = sim%m_fmm_list(ilevel)%noct(flev)
    threadsX_per_block = twotondim
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU fmm_multipole_shift_downward", color=1)!blue
       call fmm_multipole_shift_downward<<<num_blocks, dim3(threadsX_per_block,threadsY_per_block,1)>>>( &
            & grid_fmm, multipole_fmm, head_idx, num_octs, dx_loc, skip1, skip2, skip3)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_fmm_multipole_shift_downward

  !> @brief
  !> FMM-tree downward pass (L2L plus M2L) on device FMM trees.
  !>
  subroutine gpu_fmm_downward(sim, ilev, jlev, flev, use_merged)
    use nvtx
    use fmm_device, only: fmm_downward_kernel, fmm_init_distance_tables_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilev, jlev, flev
    logical, intent(in) :: use_merged

    integer(kind=4) :: head_idx, num_octs, threadsX_per_block, threadsY_per_block, num_blocks
    integer(kind=4) :: target_slot, source_slot
    integer(kind=4) :: target_grid_offset
    integer(kind=4) :: hash_offset, hash_capacity
    real(kind=dp) :: dx_loc

#ifdef FMM
    call gpu_select_fmm_tree(sim, ilev, target_slot)
    target_grid_offset = fmm_grid_offset(target_slot)

    if (ilev == jlev .and. .not. use_merged) then
       head_idx = target_grid_offset + sim%m_fmm_list(ilev)%head(flev)
       num_octs = sim%m_fmm_list(ilev)%noct(flev)
       dx_loc = real(sim%r%boxlen / 2.0D0**flev, kind=dp)
       threadsX_per_block = twotondim
       threadsY_per_block = 16
       num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
       if (num_octs > 0) then
          hash_offset = fmm_hash_offset(target_slot)
          hash_capacity = fmm_hash_capacity_slot(target_slot)
          call nvtxStartRange("GPU fmm_downward", color=1)!blue
          if (.not. fmm_distance_tables_initialized) then
             call fmm_init_distance_tables_kernel<<<32, 128>>>()
             fmm_distance_tables_initialized = .true.
          end if
          call fmm_downward_kernel<<<num_blocks, dim3(threadsX_per_block, threadsY_per_block, 1)>>>(grid_fmm, taylor_fmm, &
               & father_fmm(fmm_father_grid_offset+1), grid_fmm, multipole_fmm, taylor_fmm, &
               & nbor_fmm, source_parent_fmm, hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), &
               & hash_capacity, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
               & head_idx, num_octs, flev, dx_loc, .true.)
          call nvtxEndRange()
       end if
    else
       call gpu_select_fmm_interaction_tree(sim, jlev, use_merged, source_slot)

       head_idx = target_grid_offset + sim%m_fmm_list(ilev)%head(flev)
       num_octs = sim%m_fmm_list(ilev)%noct(flev)
       dx_loc = real(sim%r%boxlen / 2.0D0**flev, kind=dp)
       threadsX_per_block = twotondim
       threadsY_per_block = 16
       num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
       if (num_octs > 0) then
          hash_offset = fmm_hash_offset(source_slot)
          hash_capacity = fmm_hash_capacity_slot(source_slot)
          call gpu_refresh_fmm_source_parent_level(sim, ilev, flev, source_slot)
          call nvtxStartRange("GPU fmm_downward", color=1)!blue
          if (.not. fmm_distance_tables_initialized) then
             call fmm_init_distance_tables_kernel<<<32, 128>>>()
             fmm_distance_tables_initialized = .true.
          end if
          call fmm_downward_kernel<<<num_blocks, dim3(threadsX_per_block, threadsY_per_block, 1)>>>(grid_fmm, taylor_fmm, &
               & father_fmm(fmm_father_grid_offset+1), grid_fmm, multipole_fmm, taylor_fmm, &
               & nbor_fmm, source_parent_fmm, hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), &
               & hash_capacity, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
               & head_idx, num_octs, flev, dx_loc, .false.)
          call nvtxEndRange()
       end if
    end if

#endif

  end subroutine gpu_fmm_downward

  !> @brief
  !> Evaluate FMM interactions onto AMR leaf cells from a device FMM tree.
  !>
  subroutine gpu_fmm_amr_intermediate(sim, ilev, jlev, use_merged)
    use nvtx
    use fmm_device, only: fmm_amr_intermediate_kernel, fmm_init_distance_tables_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilev, jlev
    logical, intent(in) :: use_merged

    integer(kind=4) :: head_idx, num_octs, threadsX_per_block, threadsY_per_block, num_blocks
    integer(kind=4) :: tree_slot
    integer(kind=4) :: hash_offset, hash_capacity
    real(kind=dp) :: dx_loc
    logical :: reset_phi, same_tree

#ifdef FMM
    call gpu_select_fmm_interaction_tree(sim, jlev, use_merged, tree_slot)

    head_idx = sim%m%head(ilev)
    num_octs = sim%m%noct(ilev)
    dx_loc = real(sim%r%boxlen / 2.0D0**ilev, kind=dp)
    reset_phi = (jlev == ilev)
    same_tree = (jlev == ilev .and. .not. use_merged)
    threadsX_per_block = twotondim
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       hash_offset = fmm_hash_offset(tree_slot)
       hash_capacity = fmm_hash_capacity_slot(tree_slot)
       call gpu_refresh_amr_fmm_father_level(sim, ilev, tree_slot)
       call nvtxStartRange("GPU fmm_amr_intermediate", color=1)!blue
       if (.not. fmm_distance_tables_initialized) then
          call fmm_init_distance_tables_kernel<<<32, 128>>>()
          fmm_distance_tables_initialized = .true.
       end if
       call fmm_amr_intermediate_kernel<<<num_blocks, dim3(threadsX_per_block, threadsY_per_block, 1)>>>(grid, phi, father_fmm, grid_fmm, &
            & multipole_fmm, taylor_fmm, nbor_fmm, box_ckey_min, box_ckey_max, &
            & hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), hash_capacity, ckey_max, key_off, periodic, &
            & head_idx, num_octs, ilev, dx_loc, reset_phi, same_tree)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_fmm_amr_intermediate

  !> @brief
  !> Average fine-level FMM potentials back into parent AMR cells on the device.
  !>
  subroutine gpu_fmm_fill_phi(sim, ilevel)
    use nvtx
    use fmm_device, only: fmm_fill_phi_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel

    integer(kind=4) :: head_idx, num_octs, num_threads, num_blocks

#ifdef FMM
    if (ilevel >= sim%r%nlevelmax) return

    head_idx = sim%m%head(ilevel+1)
    num_octs = sim%m%noct(ilevel+1)
    num_threads = 128
    num_blocks = (num_octs + num_threads - 1) / num_threads
    if (num_octs > 0) then
       call nvtxStartRange("GPU fmm_fill_phi", color=1)!blue
       call fmm_fill_phi_kernel<<<num_blocks, num_threads>>>(grid, phi, hash_key, hash_val, &
            & sim%m%hash_size, ckey_max, key_off, head_idx, num_octs, ilevel)
       call nvtxEndRange()
    end if
#endif

  end subroutine gpu_fmm_fill_phi

  !> @brief
  !> Evaluate same-level AMR near-field direct interactions on leaf cells.
  !>
  subroutine gpu_fmm_amr_direct(sim, ilev)
    use nvtx
    use fmm_device, only: fmm_amr_direct_kernel, fmm_direct_nthreads_y, fmm_init_distance_tables_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilev

    integer(kind=4) :: head_idx, num_octs, threadsX_per_block, threadsY_per_block, num_blocks
    real(kind=dp) :: dx_loc, dxn

#ifdef FMM
    head_idx = sim%m%head(ilev)
    num_octs = sim%m%noct(ilev)
    dx_loc = real(sim%r%boxlen / 2.0D0**ilev, kind=dp)
    dxn = dx_loc**ndim
    threadsX_per_block = twotondim
    threadsY_per_block = fmm_direct_nthreads_y
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU fmm_amr_direct", color=1)!blue
       if (.not. fmm_distance_tables_initialized) then
          call fmm_init_distance_tables_kernel<<<32, 128>>>()
          fmm_distance_tables_initialized = .true.
       end if
       call fmm_amr_direct_kernel<<<num_blocks, dim3(threadsX_per_block, threadsY_per_block, 1)>>>(grid, rho, phi, nbor, hash_key, hash_val, &
            & sim%m%hash_size, ckey_max, key_off, head_idx, num_octs, ilev, dx_loc, dxn)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_fmm_amr_direct

  !> @brief
  !> Evaluate AMR direct-taylor interactions from a device FMM tree.
  !>
  subroutine gpu_fmm_amr_direct_taylor(sim, ilev, jlev, use_merged)
    use nvtx
    use fmm_device, only: fmm_amr_direct_taylor_kernel, fmm_init_distance_tables_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilev, jlev
    logical, intent(in) :: use_merged

    integer(kind=4) :: head_idx, num_octs, threadsX_per_block, threadsY_per_block, num_blocks
    integer(kind=4) :: tree_slot
    integer(kind=4) :: hash_offset, hash_capacity
    real(kind=dp) :: dx_loc

#ifdef FMM
    call gpu_select_fmm_interaction_tree(sim, jlev, use_merged, tree_slot)

    head_idx = sim%m%head(ilev)
    num_octs = sim%m%noct(ilev)
    dx_loc = real(sim%r%boxlen / 2.0D0**ilev, kind=dp)
    threadsX_per_block = twotondim
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       hash_offset = fmm_hash_offset(tree_slot)
       hash_capacity = fmm_hash_capacity_slot(tree_slot)
       call gpu_refresh_amr_fmm_grid_level(sim, ilev, tree_slot)
       call nvtxStartRange("GPU fmm_amr_direct_taylor", color=1)!blue
       if (.not. fmm_distance_tables_initialized) then
          call fmm_init_distance_tables_kernel<<<32, 128>>>()
          fmm_distance_tables_initialized = .true.
       end if
       call fmm_amr_direct_taylor_kernel<<<num_blocks, dim3(threadsX_per_block, threadsY_per_block, 1)>>>(grid, phi, source_grid_fmm, grid_fmm, &
            & multipole_fmm, nbor_fmm, hash_key_fmm(hash_offset+1), hash_val_fmm(hash_offset+1), hash_capacity, &
            & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_octs, dx_loc)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_fmm_amr_direct_taylor

  !> @brief
  !> Evaluate adjacent-level combined direct interactions on AMR leaf cells.
  !>
  subroutine gpu_fmm_combined_direct(sim, ilev)
    use nvtx
    use fmm_device, only: fmm_combined_direct_kernel
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilev

    integer(kind=4) :: head_idx, num_octs, threadsX_per_block, threadsY_per_block, num_blocks
    real(kind=dp) :: dx_loc, vol_loc

#ifdef FMM
    call gpu_refresh_amr_father_level(sim, ilev)

    head_idx = sim%m%head(ilev)
    num_octs = sim%m%noct(ilev)
    dx_loc = real(sim%r%boxlen / 2.0D0**ilev, kind=dp)
    vol_loc = dx_loc**ndim * real(twotondim, kind=dp)
    threadsX_per_block = twotondim
    threadsY_per_block = 16
    num_blocks = (num_octs + threadsY_per_block - 1) / threadsY_per_block
    if (num_octs > 0) then
       call nvtxStartRange("GPU fmm_combined_direct", color=1)!blue
       call fmm_combined_direct_kernel<<<num_blocks, dim3(threadsX_per_block, threadsY_per_block, 1)>>>(grid, rho, phi, father, nbor, &
            & box_ckey_min, box_ckey_max, head_idx, num_octs, ilev, dx_loc, vol_loc)
       call nvtxEndRange()
    end if

#endif

  end subroutine gpu_fmm_combined_direct

  !###########################################################
  !###########################################################
  !###########################################################
  !###########################################################

end module gpu_runner
