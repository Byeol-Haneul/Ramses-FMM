! =========================================================================
!> @brief
!> Find 3x3x3 nbor father cells of input oct
!>
attributes(device) function floor_div2(n)
  integer :: floor_div2
  integer, value :: n
  if (n >= 0) then
     floor_div2 = n / 2
  else
     floor_div2 = (n - 1) / 2
  endif
end function floor_div2
! =========================================================================

! =========================================================================
!> @brief
!> Find 3x3x3 nbor father cells of input oct
!>
attributes(device) subroutine nbor_father_cells(grid, father, nbor, oct_idx, igrid_nbor, icell_nbor)
  use amr_parameters, only: dp, ndim, twotondim, threetondim
  use oct_commons, only: oct
  use gpu_utils
  implicit none
  type(oct), device :: grid(*)
  integer(kind=4), device :: father(*)
  integer(kind=4), device :: nbor(1:subgridsize,*)
  integer(kind=4), value :: oct_idx
  integer(kind=4), intent(out) :: igrid_nbor(1:threetondim)
  integer(kind=4), intent(out) :: icell_nbor(1:threetondim)

  integer :: father_idx, subgrid_idx, num_idx
  integer :: i_subgrid, j_subgrid, k_subgrid
  integer :: i, j, k, inbor, ii, jj, kk, in, jn, kn
  integer :: ind_nbor, io, jo, ko, ic, jc, kc

  ! Compute parent oct idx
  father_idx = father(oct_idx)

  ! Compute subgrid idx
  subgrid_idx = (father_idx - 1) / nsubgridtondim + 1

  ! Compute father rank within subgrid
  num_idx = father_idx - (subgrid_idx - 1) * nsubgridtondim
  num_idx = num_idx - 1
  k_subgrid = num_idx / nsubgridsq
  num_idx = num_idx - k_subgrid * nsubgridsq
  j_subgrid = num_idx / nsubgrid
  i_subgrid = num_idx - j_subgrid * nsubgrid
  i_subgrid = i_subgrid + 1
  j_subgrid = j_subgrid + 1
  k_subgrid = k_subgrid + 1

  ! Compute parent cell coordinates inside oct
  i = grid(oct_idx)%ckey(1) - 2 * (grid(oct_idx)%ckey(1) / 2)
  j = grid(oct_idx)%ckey(2) - 2 * (grid(oct_idx)%ckey(2) / 2)
  k = grid(oct_idx)%ckey(3) - 2 * (grid(oct_idx)%ckey(3) / 2)

  ! Loop over 27 neighboring cells
  inbor = 0
  do kk = -1, +1
     do jj = -1, +1
        do ii = -1, +1
           inbor = inbor + 1

           ! Index of nbor cells
           in = i + ii + 2 * (i_subgrid - 1)
           jn = j + jj + 2 * (j_subgrid - 1)
           kn = k + kk + 2 * (k_subgrid - 1)

           ! Index of parent octs
           io = floor_div2(in)
           jo = floor_div2(jn)
           ko = floor_div2(kn)

           ! Cell coordinates within that parent
           ic = in - 2 * io
           jc = jn - 2 * jo
           kc = kn - 2 * ko

           ! Store results in output array
           ind_nbor = 1 + (io + 1) + (jo + 1) * nsubgridp2 + (ko + 1) * nsubgridp2sq
           igrid_nbor(inbor) = nbor(ind_nbor, subgrid_idx)
           icell_nbor(inbor) = 1 + ic + jc * 2 + kc * 4
        end do
     end do
  end do

end subroutine nbor_father_cells
! =========================================================================

! =========================================================================
!> @brief
!> Find 3x3x3 nbor father cells of input oct
!>
attributes(device) subroutine nbor_father_cells_mg(grid, father, nbor, oct_idx, mg_idx, igrid_nbor, icell_nbor)
  use amr_parameters, only: dp, ndim, twotondim, threetondim
  use oct_commons, only: oct
  use gpu_utils
  implicit none
  type(oct), device :: grid(*)
  integer(kind=4), device :: father(*)
  integer(kind=4), device :: nbor(1:subgridsize,*)
  integer(kind=4), value :: oct_idx
  integer(kind=4), value :: mg_idx
  integer(kind=4), intent(out) :: igrid_nbor(1:threetondim)
  integer(kind=4), intent(out) :: icell_nbor(1:threetondim)

  integer :: father_idx, subgrid_idx, num_idx
  integer :: i_subgrid, j_subgrid, k_subgrid
  integer :: i, j, k, inbor, ii, jj, kk, in, jn, kn
  integer :: ind_nbor, io, jo, ko, ic, jc, kc

  ! Compute parent oct idx
  father_idx = father(mg_idx)

  ! Compute subgrid idx
  subgrid_idx = (father_idx - 1) / nsubgridtondim + 1

  ! Compute father rank within subgrid
  num_idx = father_idx - (subgrid_idx - 1) * nsubgridtondim
  num_idx = num_idx - 1
  k_subgrid = num_idx / nsubgridsq
  num_idx = num_idx - k_subgrid * nsubgridsq
  j_subgrid = num_idx / nsubgrid
  i_subgrid = num_idx - j_subgrid * nsubgrid
  i_subgrid = i_subgrid + 1
  j_subgrid = j_subgrid + 1
  k_subgrid = k_subgrid + 1

  ! Compute parent cell coordinates inside oct
  i = grid(oct_idx)%ckey(1) - 2 * (grid(oct_idx)%ckey(1) / 2)
  j = grid(oct_idx)%ckey(2) - 2 * (grid(oct_idx)%ckey(2) / 2)
  k = grid(oct_idx)%ckey(3) - 2 * (grid(oct_idx)%ckey(3) / 2)

  ! Loop over 27 neighbors
  inbor = 0
  do kk = -1, +1
     do jj = -1, +1
        do ii = -1, +1
           inbor = inbor + 1

           ! Index of nbor cells
           in = i + ii + 2 * (i_subgrid - 1)
           jn = j + jj + 2 * (j_subgrid - 1)
           kn = k + kk + 2 * (k_subgrid - 1)

           ! Index of parent octs
           io = floor_div2(in)
           jo = floor_div2(jn)
           ko = floor_div2(kn)

           ! Cell coordinates within that parent
           ic = in - 2 * io
           jc = jn - 2 * jo
           kc = kn - 2 * ko

           ! Store results in output array
           ind_nbor = 1 + (io + 1) + (jo + 1) * nsubgridp2 + (ko + 1) * nsubgridp2sq
           igrid_nbor(inbor) = nbor(ind_nbor, subgrid_idx)
           icell_nbor(inbor) = 1 + ic + jc * 2 + kc * 4
        end do
     end do
  end do

end subroutine nbor_father_cells_mg
! =========================================================================

! =========================================================================
!> @brief
!> Build the same linearized oct hash key used by the GPU AMR hash table.
!>
attributes(device) function grid_hash_key_from_ckey(ckey, ilevel, ckey_max, key_off) result(key)
  use amr_parameters, only: ndim
  implicit none
  integer(kind=4), intent(in) :: ckey(1:3)
  integer(kind=4), value :: ilevel
  integer(kind=4), device :: ckey_max(*)
  integer(kind=8), device :: key_off(*)
  integer(kind=8) :: key

  integer(kind=8) :: ix, iy, iz, nx, offset

  ix = int(ckey(1), kind=8)
  iy = 0_8
  iz = 0_8
  if (ndim > 1) iy = int(ckey(2), kind=8)
  if (ndim > 2) iz = int(ckey(3), kind=8)
  nx = int(ckey_max(ilevel), kind=8)
  offset = key_off(ilevel)
  key = offset + ix + iy * nx + iz * nx * nx

end function grid_hash_key_from_ckey
! =========================================================================

! =========================================================================
attributes(device) function lookup_grid_by_ckey(ckey, ilevel, hash_key, hash_val, hash_size, &
     & ckey_max, key_off) result(igrid)
  use amr_parameters, only: ndim
  implicit none
  integer(kind=4), intent(in) :: ckey(1:3)
  integer(kind=4), value :: ilevel
  integer(kind=8), device :: hash_key(*)
  integer(kind=4), device :: hash_val(*)
  integer(kind=4), value :: hash_size
  integer(kind=4), device :: ckey_max(*)
  integer(kind=8), device :: key_off(*)
  integer(kind=4) :: igrid

  integer(kind=8) :: key

  key = grid_hash_key_from_ckey(ckey, ilevel, ckey_max, key_off)
  igrid = hash_get(hash_key, hash_val, hash_size, key)

end function lookup_grid_by_ckey
! =========================================================================

! =========================================================================
attributes(device) subroutine wrap_grid_ckey(ckey, ilevel, box_ckey_min, box_ckey_max, periodic, in_domain)
  use amr_parameters, only: ndim
  implicit none
  integer(kind=4), intent(inout) :: ckey(1:3)
  integer(kind=4), value :: ilevel
  integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
  logical, device :: periodic(1:3)
  logical, intent(out) :: in_domain

  integer :: idim

  in_domain = .true.
  do idim = 1, ndim
     if (periodic(idim)) then
        if (ckey(idim) < box_ckey_min(idim, ilevel)) ckey(idim) = box_ckey_max(idim, ilevel) - 1
        if (ckey(idim) >= box_ckey_max(idim, ilevel)) ckey(idim) = box_ckey_min(idim, ilevel)
     end if
     in_domain = in_domain .and. ckey(idim) >= box_ckey_min(idim, ilevel) &
          &                  .and. ckey(idim) <  box_ckey_max(idim, ilevel)
  end do

end subroutine wrap_grid_ckey
! =========================================================================

! =========================================================================
attributes(device) subroutine get_parent_cell_device(grid, hash_key, hash_val, hash_size, ckey_max, key_off, &
     & child_ckey, child_level, igrid, icell)
  use amr_parameters, only: ndim
  use oct_commons, only: oct
  implicit none
  type(oct), device :: grid(*)
  integer(kind=8), device :: hash_key(*)
  integer(kind=4), device :: hash_val(*)
  integer(kind=4), value :: hash_size
  integer(kind=4), device :: ckey_max(*)
  integer(kind=8), device :: key_off(*)
  integer(kind=4), intent(in) :: child_ckey(1:3)
  integer(kind=4), value :: child_level
  integer(kind=4), intent(out) :: igrid, icell

  integer(kind=4) :: parent_ckey(1:3), ii(1:3)
  integer :: idim

  parent_ckey = 0
  ii = 0
  do idim = 1, ndim
     parent_ckey(idim) = child_ckey(idim) / 2
     ii(idim) = child_ckey(idim) - 2 * parent_ckey(idim)
  end do

  icell = 1
  do idim = 1, ndim
     icell = icell + 2**(idim-1) * ii(idim)
  end do
  igrid = lookup_grid_by_ckey(parent_ckey, child_level-1, hash_key, hash_val, hash_size, ckey_max, key_off)

end subroutine get_parent_cell_device
! =========================================================================

! =========================================================================
attributes(device) subroutine get_threetondim_nbor_grid_device(hash_key_table, hash_val, hash_size, ckey_max, key_off, &
     & box_ckey_min, box_ckey_max, periodic, center_ckey, ilevel, igrid_nbor)
  use amr_parameters, only: ndim, threetondim
  implicit none
  integer(kind=8), device :: hash_key_table(*)
  integer(kind=4), device :: hash_val(*)
  integer(kind=4), value :: hash_size
  integer(kind=4), device :: ckey_max(*)
  integer(kind=8), device :: key_off(*)
  integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
  logical, device :: periodic(1:3)
  integer(kind=4), intent(in) :: center_ckey(1:3)
  integer(kind=4), value :: ilevel
  integer(kind=4), intent(out) :: igrid_nbor(1:threetondim)

  integer(kind=4) :: nbor_ckey(1:3)
  integer :: i1, j1, k1, inbor
  logical :: in_domain

  inbor = 0
  do k1 = -1*(ndim/3), 1*(ndim/3)
     do j1 = -1*(ndim/2), 1*(ndim/2)
        do i1 = -1, 1
           inbor = inbor + 1
           nbor_ckey = 0
           nbor_ckey(1) = center_ckey(1) + i1
           if (ndim > 1) nbor_ckey(2) = center_ckey(2) + j1
           if (ndim > 2) nbor_ckey(3) = center_ckey(3) + k1
           call wrap_grid_ckey(nbor_ckey, ilevel, box_ckey_min, box_ckey_max, periodic, in_domain)
           if (in_domain) then
              igrid_nbor(inbor) = lookup_grid_by_ckey(nbor_ckey, ilevel, hash_key_table, hash_val, &
                   & hash_size, ckey_max, key_off)
           else
              igrid_nbor(inbor) = 0
           end if
        end do
     end do
  end do

end subroutine get_threetondim_nbor_grid_device
! =========================================================================

! =========================================================================
attributes(device) subroutine get_intermediate_nbor_grid_device(hash_key_table, hash_val, hash_size, ckey_max, key_off, &
     & box_ckey_min, box_ckey_max, periodic, child_ckey, child_level, igrid_nbor)
  use amr_parameters, only: ndim, threetondim
  implicit none
  integer(kind=8), device :: hash_key_table(*)
  integer(kind=4), device :: hash_val(*)
  integer(kind=4), value :: hash_size
  integer(kind=4), device :: ckey_max(*)
  integer(kind=8), device :: key_off(*)
  integer(kind=4), device :: box_ckey_min(1:3,*), box_ckey_max(1:3,*)
  logical, device :: periodic(1:3)
  integer(kind=4), intent(in) :: child_ckey(1:3)
  integer(kind=4), value :: child_level
  integer(kind=4), intent(out) :: igrid_nbor(1:threetondim)

  integer(kind=4) :: parent_ckey(1:3)
  integer :: idim

  parent_ckey = 0
  do idim = 1, ndim
     parent_ckey(idim) = child_ckey(idim) / 2
  end do
  call get_threetondim_nbor_grid_device(hash_key_table, hash_val, hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, parent_ckey, child_level-1, igrid_nbor)

end subroutine get_intermediate_nbor_grid_device
! =========================================================================
