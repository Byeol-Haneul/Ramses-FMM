make NDIM=3 MPI=1 GRAV=1 HYDRO=0

&RUN_PARAMS
cosmo=.false.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.true.
/

&OUTPUT_PARAMS
tend=0.001
bkp_time_hrs=1
bkp_modulo=3
/

&INIT_PARAMS
filetype='ascii'
initfile(1)='single_offset'
ic_scale_m=1.00
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=4000000
npartmax=8000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-6
part_mass_deposition_scheme=1
level_fmm_to_amr=1
/

&REFINE_PARAMS
m_refine=10*0.1,
/
