&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
clump_finder=.true.
/

&OUTPUT_PARAMS
delta_aout=0.1
aend=1.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=15
ngridmax=20000000
npartmax=40000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=10*8.,
/

&OUTPUT_PARAMS
delta_aout=0.01
aend=1.0
foutput=100
/

&CLUMP_PARAMS
clump_info=.true.
output_clump=.false.
output_clump_field=.false.
/
